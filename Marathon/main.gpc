// ===== INIT =====
// ===== DATA FUNCTIONS =====
// Weapon names
const string Weapons[] = { "OVERRUN", "V75 SCAR", "IMPACT H-AR", "M77", "RETALIATOR", "DEMOLITION", "CONQUEST", "HARDLINE", "REPEATER", "V66 LOOKOUT", "BR33", "TWIN TAP", "STRYDER", "V11 PUNCH", "CE TACTICAL", "MAGNUM", "V00 ZEUS", "ARES", "MISRIAH", "V85 CIRCUIT", "WSTR", "OUTLAND", "V99 CHANNEL", "LONGSHOT", "COPPERHEAD", "BULLY", "V22 VOLT", "BRRT" };

// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon[Flow_CurrentProfile];
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}


// ===== GAMEPLAY COMBOS =====
// Combo: Custom
combo ExecutePrime {
    set_val(PS5_R1, 0);
    set_val(PS5_L1, 0);
    wait(40);
    set_val(PS5_R1, 100);
    set_val(PS5_L1, 100);
    wait(40);
    set_val(PS5_R1, 0);
    set_val(PS5_L1, 0);
    wait(40 - get_rtime());
    set_val(PS5_R1, 0);
    set_val(PS5_L1, 0);
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Crouch Shot
combo CrouchShot {
    set_val(PS5_CIRCLE, 100);
    wait(jitter(75));
    set_val(PS5_CIRCLE, 0);
    wait(jitter(125));
}

// Combo: Evasive Edge
combo EvasiveEdge {
    set_val(PS5_LX, -75);
    wait(jitter(150));
    set_val(PS5_LX, 75);
    wait(jitter(150));
}

// Combo: Keyboard
function ApplyKeyboard() {
    if (GetKeyboardKey(KEY_F)) { combo_run(ExecutePrime); }
    if (GetKeyboardKey(KEY_X)) { combo_run(ThiefDashTech); }
}

// Combo: Always Run
// Always Run uses direct set_val, no combo needed

// Combo: Custom
combo ThiefDashTech {
    set_val(PS5_CIRCLE, 100);
    wait(20);
    set_val(PS5_CIRCLE, 0);
    wait(20);
    set_val(PS5_L1, 100);
    wait(20);
    set_val(PS5_L1, 0);
    wait(20);
    set_val(PS5_L1, 100);
    wait(20);
    set_val(PS5_L1, 0);
    wait(20);
    set_val(PS5_CROSS, 100);
    wait(20);
    set_val(PS5_CROSS, 0);
    wait(50);
}

// Combo: Anti Recoil (Basic)
define ANTIRECOIL_INIT_DELAY = 15;  // Skip first ~150ms of firing (minimal recoil)

combo AntiRecoil {
    active_weapon = GetActiveWeapon();

    // Per-weapon recoil values
    Recoil_Vertical = Weapons_RecoilValues[active_weapon * 2];
    Recoil_Horizontal = Weapons_RecoilValues[active_weapon * 2 + 1];

    // Advance LCG seed every cycle for well-distributed variance
    _jitter_seed = (_jitter_seed * 1103515245 + 12345) ^ get_rtime();

    // Per-cycle variance: ±15% of base value, V and H derived independently
    random_variance_v = (abs(_jitter_seed) % 31) - 15;
    random_variance_h = (abs(_jitter_seed / 31) % 23) - 11;

    if (Recoil_Vertical != 0) {
        set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical + (random_variance_v * abs(Recoil_Vertical) / 100), -100, 100));
    }
    if (Recoil_Horizontal != 0) {
        set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal + (random_variance_h * abs(Recoil_Horizontal) / 100), -100, 100));
    }
}

// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// Combo: Auto Run KB
// Auto Run KB uses direct set_val, no combo needed

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Custom
// Add your functions here

// Functions: VM Speed
const string VMSpeedLabels[] = { "10ms", "8ms", "4ms", "2ms", "1ms" };

function ApplyVMSpeed() {
    if (VMSpeedIndex == 0) { vm_tctrl(0); }
    else if (VMSpeedIndex == 1) { vm_tctrl(-2); } // 8ms Xbox One
    else if (VMSpeedIndex == 2) { vm_tctrl(-6); } // 4ms PS4/PS5
    else if (VMSpeedIndex == 3) { vm_tctrl(-8); } // 2ms Xbox X/S
    else if (VMSpeedIndex == 4) { vm_tctrl(-9); } // 1ms PC
}

