// ===== STATE: Rapid Fire =====
function FlowState_Rapid_Fire() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Rapid_Fire_cursor > 0) { Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Rapid_Fire_cursor < 2) { Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Rapid_Fire_cursor < Flow_Rapid_Fire_scroll) Flow_Rapid_Fire_scroll = Flow_Rapid_Fire_cursor;
    if(Flow_Rapid_Fire_cursor >= Flow_Rapid_Fire_scroll + 5) Flow_Rapid_Fire_scroll = Flow_Rapid_Fire_cursor - 5 + 1;

    // Toggle: Status
    if(Flow_Rapid_Fire_cursor == 0 && event_press(PS5_CROSS)) {
        RapidFireStatus = !RapidFireStatus; FlowRedraw = TRUE;
    }
    // Value adjust: Speed
    if(Flow_Rapid_Fire_cursor == 1) {
        if(event_press(PS5_LEFT) && RapidFireSpeed > 1) { RapidFireSpeed = RapidFireSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && RapidFireSpeed < 10) { RapidFireSpeed = RapidFireSpeed + 1; FlowRedraw = TRUE; }
        if(event_press(PS5_L1) && RapidFireSpeed > 1) { RapidFireSpeed = RapidFireSpeed - 10; if(RapidFireSpeed < 1) RapidFireSpeed = 1; FlowRedraw = TRUE; }
        if(event_press(PS5_R1) && RapidFireSpeed < 10) { RapidFireSpeed = RapidFireSpeed + 10; if(RapidFireSpeed > 10) RapidFireSpeed = 10; FlowRedraw = TRUE; }
    }
    // Toggle: Hip Fire
    if(Flow_Rapid_Fire_cursor == 2 && event_press(PS5_CROSS)) {
        RapidFireHipFire = !RapidFireHipFire; FlowRedraw = TRUE;
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Rapid_Fire_scroll * 9;
        if(0 >= Flow_Rapid_Fire_scroll && 0 < Flow_Rapid_Fire_scroll + 5) {
            // Toggle: Status (index 0)
            if(Flow_Rapid_Fire_cursor == 0) print(15, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
            print(27, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[2]);
            if(RapidFireStatus) print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[0]);
            else print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[1]);
        }
        if(1 >= Flow_Rapid_Fire_scroll && 1 < Flow_Rapid_Fire_scroll + 5) {
            // Value: Speed (index 1)
            if(Flow_Rapid_Fire_cursor == 1) print(15, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
            print(27, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[4]);
            PrintNumber(RapidFireSpeed, find_digits(RapidFireSpeed), 98, (19 - _oled_y_off), OLED_FONT_SMALL);
        }
        if(2 >= Flow_Rapid_Fire_scroll && 2 < Flow_Rapid_Fire_scroll + 5) {
            // Toggle: Hip Fire (index 2)
            if(Flow_Rapid_Fire_cursor == 2) print(15, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
            print(27, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[5]);
            if(RapidFireHipFire) print(110, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[0]);
            else print(110, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[1]);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

