    // Array cycle: Speed
    if(Flow_VM_Speed_cursor == 0) {
        if(event_press(PS5_LEFT)) { VMSpeedIndex--; if(VMSpeedIndex < 0) VMSpeedIndex = 4; FlowRedraw = TRUE; ApplyVMSpeed(); }
        if(event_press(PS5_RIGHT)) { VMSpeedIndex++; if(VMSpeedIndex > 4) VMSpeedIndex = 0; FlowRedraw = TRUE; ApplyVMSpeed(); }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
