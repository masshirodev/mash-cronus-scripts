// ===== STATE: Home =====
function FlowState_Home() {

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_Home_img0[0]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(FlowStateTimer > 3000) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_States;
    }
    if(((get_val(PS5_L2) && event_press(PS5_OPTIONS)) || (GetKeyboardKey(KEY_BACKSPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Module Settings =====
function FlowState_Module_Settings() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Module_Settings_cursor < 8) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Module_Settings_cursor < Flow_Module_Settings_scroll) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor;
    if(Flow_Module_Settings_cursor >= Flow_Module_Settings_scroll + 5) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor - 5 + 1;

    // Array cycle: Array
    if(Flow_Module_Settings_cursor == 0) {
        if(event_press(PS5_LEFT)) { CurrentWeapon[Flow_CurrentProfile]--; if(CurrentWeapon[Flow_CurrentProfile] < 0) CurrentWeapon[Flow_CurrentProfile] = (WEAPON_COUNT - 1); FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT)) { CurrentWeapon[Flow_CurrentProfile]++; if(CurrentWeapon[Flow_CurrentProfile] > (WEAPON_COUNT - 1)) CurrentWeapon[Flow_CurrentProfile] = 0; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Module_Settings_scroll * 9;
        if(0 >= Flow_Module_Settings_scroll && 0 < Flow_Module_Settings_scroll + 5) {
            // Array: Array (index 0)
            if(Flow_Module_Settings_cursor == 0) print(15, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            print(27, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon[Flow_CurrentProfile]]);
        }
        if(1 >= Flow_Module_Settings_scroll && 1 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Anti Recoil (index 1)
            if(Flow_Module_Settings_cursor == 1) {
                print(15, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
        }
        if(2 >= Flow_Module_Settings_scroll && 2 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Rapid Fire (index 2)
            if(Flow_Module_Settings_cursor == 2) {
                print(15, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (28 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
        }
        if(3 >= Flow_Module_Settings_scroll && 3 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Auto Ping (index 3)
            if(Flow_Module_Settings_cursor == 3) {
                print(15, (37 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (37 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[4]);
        }
        if(4 >= Flow_Module_Settings_scroll && 4 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Crouch Shot (index 4)
            if(Flow_Module_Settings_cursor == 4) {
                print(15, (46 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (46 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[5]);
        }
        if(5 >= Flow_Module_Settings_scroll && 5 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Evasive Edge (index 5)
            if(Flow_Module_Settings_cursor == 5) {
                print(15, (55 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (55 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[6]);
        }
        if(6 >= Flow_Module_Settings_scroll && 6 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Always Run (index 6)
            if(Flow_Module_Settings_cursor == 6) {
                print(15, (64 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (64 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[7]);
        }
        if(7 >= Flow_Module_Settings_scroll && 7 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Auto Run KB (index 7)
            if(Flow_Module_Settings_cursor == 7) {
                print(15, (73 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (73 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[8]);
        }
        if(8 >= Flow_Module_Settings_scroll && 8 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: VM Speed (index 8)
            if(Flow_Module_Settings_cursor == 8) {
                print(15, (82 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (82 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[9]);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 3 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Ping;
    }
    if(Flow_Module_Settings_cursor == 4 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Crouch_Shot;
    }
    if(Flow_Module_Settings_cursor == 5 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Evasive_Edge;
    }
    if(Flow_Module_Settings_cursor == 2 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Rapid_Fire;
    }
    if(Flow_Module_Settings_cursor == 6 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Always_Run;
    }
    if(Flow_Module_Settings_cursor == 7 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Run_KB;
    }
    if(Flow_Module_Settings_cursor == 8 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_VM_Speed;
    }
    if(Flow_Module_Settings_cursor == 1 && ((event_press(PS5_CROSS)) || (GetKeyboardKey(KEY_SPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Anti_Recoil_Basic_;
    }
}

// ===== STATE: Auto Ping =====
function FlowState_Auto_Ping() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Auto_Ping_cursor > 0) { Flow_Auto_Ping_cursor = Flow_Auto_Ping_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Auto_Ping_cursor < 1) { Flow_Auto_Ping_cursor = Flow_Auto_Ping_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Auto_Ping_cursor < Flow_Auto_Ping_scroll) Flow_Auto_Ping_scroll = Flow_Auto_Ping_cursor;
    if(Flow_Auto_Ping_cursor >= Flow_Auto_Ping_scroll + 5) Flow_Auto_Ping_scroll = Flow_Auto_Ping_cursor - 5 + 1;

    // Toggle: Status
    if(Flow_Auto_Ping_cursor == 0 && event_press(PS5_CROSS)) {
        AutoPingStatus = !AutoPingStatus; FlowRedraw = TRUE;
    }
    // Value adjust: Interval
    if(Flow_Auto_Ping_cursor == 1) {
        if(event_press(PS5_LEFT) && AutoPingInterval > 100) { AutoPingInterval = AutoPingInterval - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AutoPingInterval < 2000) { AutoPingInterval = AutoPingInterval + 1; FlowRedraw = TRUE; }
        if(event_press(PS5_L1) && AutoPingInterval > 100) { AutoPingInterval = AutoPingInterval - 10; if(AutoPingInterval < 100) AutoPingInterval = 100; FlowRedraw = TRUE; }
        if(event_press(PS5_R1) && AutoPingInterval < 2000) { AutoPingInterval = AutoPingInterval + 10; if(AutoPingInterval > 2000) AutoPingInterval = 2000; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Auto_Ping_scroll * 9;
        if(0 >= Flow_Auto_Ping_scroll && 0 < Flow_Auto_Ping_scroll + 5) {
            // Toggle: Status (index 0)
            if(Flow_Auto_Ping_cursor == 0) print(15, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[3]);
            print(27, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[2]);
            if(AutoPingStatus) print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[0]);
            else print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[1]);
        }
        if(1 >= Flow_Auto_Ping_scroll && 1 < Flow_Auto_Ping_scroll + 5) {
            // Value: Interval (index 1)
            if(Flow_Auto_Ping_cursor == 1) print(15, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[3]);
            print(27, (19 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[4]);
            PrintNumber(AutoPingInterval, find_digits(AutoPingInterval), 98, (19 - _oled_y_off), OLED_FONT_SMALL);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Crouch Shot =====
function FlowState_Crouch_Shot() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Crouch_Shot_cursor > 0) { Flow_Crouch_Shot_cursor = Flow_Crouch_Shot_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Crouch_Shot_cursor < 0) { Flow_Crouch_Shot_cursor = Flow_Crouch_Shot_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Crouch_Shot_cursor < Flow_Crouch_Shot_scroll) Flow_Crouch_Shot_scroll = Flow_Crouch_Shot_cursor;
    if(Flow_Crouch_Shot_cursor >= Flow_Crouch_Shot_scroll + 5) Flow_Crouch_Shot_scroll = Flow_Crouch_Shot_cursor - 5 + 1;

    // Toggle: Status
    if(Flow_Crouch_Shot_cursor == 0 && event_press(PS5_CROSS)) {
        CrouchShotStatus = !CrouchShotStatus; FlowRedraw = TRUE;
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Crouch_Shot_scroll * 9;
        if(0 >= Flow_Crouch_Shot_scroll && 0 < Flow_Crouch_Shot_scroll + 5) {
            // Toggle: Status (index 0)
            if(Flow_Crouch_Shot_cursor == 0) print(15, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Crouch_Shot[3]);
            print(27, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Crouch_Shot[2]);
            if(CrouchShotStatus) print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Crouch_Shot[0]);
            else print(110, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Crouch_Shot[1]);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(AutoPingStatus != _prev_AutoPingStatus) { _prev_AutoPingStatus = AutoPingStatus; FlowRedraw = TRUE; }
    if(AlwaysRunStatus != _prev_AlwaysRunStatus) { _prev_AlwaysRunStatus = AlwaysRunStatus; FlowRedraw = TRUE; }
    if(AutoRunKBStatus != _prev_AutoRunKBStatus) { _prev_AutoRunKBStatus = AutoRunKBStatus; FlowRedraw = TRUE; }
    if(EvasiveEdgeStatus != _prev_EvasiveEdgeStatus) { _prev_EvasiveEdgeStatus = EvasiveEdgeStatus; FlowRedraw = TRUE; }
    if(CrouchShotStatus != _prev_CrouchShotStatus) { _prev_CrouchShotStatus = CrouchShotStatus; FlowRedraw = TRUE; }
    if(Flow_CurrentProfile != _prev_Flow_CurrentProfile) { _prev_Flow_CurrentProfile = Flow_CurrentProfile; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(58, 25, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(58, 18, TRUE, TRUE, Flow_States_img2[0]); }
        // Pixel Art: Auto Ping Status (conditional)
        if(AutoPingStatus == 1) { image_oled(58, 39, TRUE, TRUE, Flow_States_img3[0]); }
        // Pixel Art: Always Run Status (conditional)
        if(AlwaysRunStatus == 1) { image_oled(58, 46, TRUE, TRUE, Flow_States_img4[0]); }
        // Pixel Art: Auto Run Status (conditional)
        if(AutoRunKBStatus == 1) { image_oled(58, 53, TRUE, TRUE, Flow_States_img5[0]); }
        // Pixel Art: Evasive Edge Status (conditional)
        if(EvasiveEdgeStatus == 1) { image_oled(58, 32, TRUE, TRUE, Flow_States_img6[0]); }
        // Pixel Art: Crouch Shot Status (conditional)
        if(CrouchShotStatus == 1) { image_oled(117, 18, TRUE, TRUE, Flow_States_img7[0]); }
        // Pixel Art: Profile #1 (conditional)
        if(Flow_CurrentProfile == 0) { image_oled(18, 5, TRUE, TRUE, Flow_States_img8[0]); }
        // Pixel Art: Profile #2 (conditional)
        if(Flow_CurrentProfile == 1) { image_oled(17, 5, TRUE, TRUE, Flow_States_img9[0]); }
        print(47, 4, OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon[Flow_CurrentProfile]]);
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(((get_val(PS5_L2) && event_press(PS5_OPTIONS)) || (GetKeyboardKey(KEY_BACKSPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

