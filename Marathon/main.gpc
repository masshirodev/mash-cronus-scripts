// ===== WEAPON DEFAULTS FUNCTION =====
function InitWeaponDefaults() {
    _wd_RapidFireStatus[0] = 0;
    _wd_RapidFireStatus[1] = 0;
    _wd_RapidFireStatus[2] = 0;
    _wd_RapidFireStatus[3] = 0;
    _wd_RapidFireStatus[4] = 0;
    _wd_RapidFireStatus[5] = 0;
    _wd_RapidFireStatus[6] = 0;
    _wd_RapidFireStatus[7] = 1;
    _wd_RapidFireStatus[8] = 1;
    _wd_RapidFireStatus[9] = 1;
    _wd_RapidFireStatus[10] = 1;
    _wd_RapidFireStatus[11] = 1;
    _wd_RapidFireStatus[12] = 1;
    _wd_RapidFireStatus[13] = 1;
    _wd_RapidFireStatus[14] = 1;
    _wd_RapidFireStatus[15] = 1;
    _wd_RapidFireStatus[16] = 0;
    _wd_RapidFireStatus[17] = 0;
    _wd_RapidFireStatus[18] = 1;
    _wd_RapidFireStatus[19] = 1;
    _wd_RapidFireStatus[20] = 1;
    _wd_RapidFireStatus[21] = 0;
    _wd_RapidFireStatus[22] = 0;
    _wd_RapidFireStatus[23] = 0;
    _wd_RapidFireStatus[24] = 0;
    _wd_RapidFireStatus[25] = 0;
    _wd_RapidFireStatus[26] = 0;
    _wd_RapidFireStatus[27] = 0;
}

function ApplyWeaponDefaults() {
    // Save outgoing weapon values
    if(_prev_CurrentWeapon >= 0) {
        _wd_RapidFireStatus[_prev_CurrentWeapon] = RapidFireStatus;
    }
    // Load incoming weapon values
    RapidFireStatus = _wd_RapidFireStatus[CurrentWeapon[Flow_CurrentProfile]];
}

// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;
int _bp_loop_i;
int _bp_sparse_count;
int _bp_loop_j;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(KeyboardStatus, -32768, 32767);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(AimCircularStatus, -32768, 32767);
    save_spvar(AimCircularSize, 1, 30);
    save_spvar(AimCircularSpeed, 0, 5);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoRunKBStatus, -32768, 32767);
    save_spvar(CrouchShotStatus, -32768, 32767);
    save_spvar(EvasiveEdgeStatus, -32768, 32767);
    save_spvar(AR_Vertical, -100, 100);
    save_spvar(AR_Horizontal, -100, 100);
    save_spvar(RapidFireHipFire, -32768, 32767);
    save_spvar(CurrentWeapon[0], 0, 255);
    save_spvar(CurrentWeapon[1], 0, 255);
    save_spvar(VMSpeedIndex, 0, 4);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        save_spvar(Weapons_RecoilValues[_bp_loop_i], -100, 100);
    }
    _bp_sparse_count = 0;
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT; _bp_loop_i++) {
        if(_wd_RapidFireStatus[_bp_loop_i * 1 + 0] != 0) _bp_sparse_count++;
    }
    save_spvar(_bp_sparse_count, 0, WEAPON_COUNT);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT; _bp_loop_i++) {
        if(_wd_RapidFireStatus[_bp_loop_i * 1 + 0] != 0) {
            save_spvar(_bp_loop_i, 0, WEAPON_COUNT);
            save_spvar(_wd_RapidFireStatus[_bp_loop_i * 1 + 0], 0, 1);
        }
    }
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    KeyboardStatus = read_spvar(-32768, 32767, 1);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 2);
    AimCircularStatus = read_spvar(-32768, 32767, 0);
    AimCircularSize = read_spvar(1, 30, 15);
    AimCircularSpeed = read_spvar(0, 5, 1);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoRunKBStatus = read_spvar(-32768, 32767, 0);
    CrouchShotStatus = read_spvar(-32768, 32767, 0);
    EvasiveEdgeStatus = read_spvar(-32768, 32767, 0);
    AR_Vertical = read_spvar(-100, 100, 0);
    AR_Horizontal = read_spvar(-100, 100, 0);
    RapidFireHipFire = read_spvar(-32768, 32767, 1);
    CurrentWeapon[0] = read_spvar(0, 255, 0);
    CurrentWeapon[1] = read_spvar(0, 255, 0);
    VMSpeedIndex = read_spvar(0, 4, 2);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        Weapons_RecoilValues[_bp_loop_i] = read_spvar(-100, 100, 0);
    }
    _bp_sparse_count = read_spvar(0, WEAPON_COUNT, 0);
    for(_bp_loop_j = 0; _bp_loop_j < _bp_sparse_count; _bp_loop_j++) {
        _bp_loop_i = read_spvar(0, WEAPON_COUNT, 0);
        _wd_RapidFireStatus[_bp_loop_i * 1 + 0] = read_spvar(0, 1, 0);
    }
}

// ===== INIT =====
init {
    // --- Profile Defaults ---
    CurrentWeapon[0] = 0;
    CurrentWeapon[1] = 1;
    // --- Menu Init ---
    FlowCurrentState = FLOW_STATE_Home;

    // --- Gameplay Init ---
    // Init: VM Speed
    ApplyVMSpeed();
    InitWeaponDefaults();
    InitializeWeaponData();
    Flow_Load();
    WeaponData_Initialized = TRUE;
    // --- Weapon Defaults Init ---
    RapidFireStatus = _wd_RapidFireStatus[CurrentWeapon[Flow_CurrentProfile]];
    _prev_CurrentWeapon = CurrentWeapon[Flow_CurrentProfile];
}

// ===== MAIN LOOP =====
main {

    // --- Profile Switching ---
    if(get_val(PS5_L2) && event_press(PS5_TRIANGLE)) {
        Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2] = AR_Vertical;
        Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2 + 1] = AR_Horizontal;
        Flow_CurrentProfile = Flow_CurrentProfile + 1;
        if(Flow_CurrentProfile >= 2) Flow_CurrentProfile = 0;
        AR_Vertical = Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2];
        AR_Horizontal = Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2 + 1];
        _ar_prev_weapon = CurrentWeapon[Flow_CurrentProfile];
        FlowRedraw = TRUE;
    }
    if(GetKeyboardKey(KEY_CAPSLOCK) && _kb_profile_delay <= 0) {
        Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2] = AR_Vertical;
        Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2 + 1] = AR_Horizontal;
        Flow_CurrentProfile = Flow_CurrentProfile + 1;
        if(Flow_CurrentProfile >= 2) Flow_CurrentProfile = 0;
        AR_Vertical = Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2];
        AR_Horizontal = Weapons_RecoilValues[CurrentWeapon[Flow_CurrentProfile] * 2 + 1];
        _ar_prev_weapon = CurrentWeapon[Flow_CurrentProfile];
        FlowRedraw = TRUE;
        _kb_profile_delay = 30;
    }
    if(_kb_profile_delay > 0) _kb_profile_delay--;

    // --- Weapon Defaults ---
    if(CurrentWeapon[Flow_CurrentProfile] != _prev_CurrentWeapon) {
        ApplyWeaponDefaults();
        _prev_CurrentWeapon = CurrentWeapon[Flow_CurrentProfile];
        FlowRedraw = TRUE;
    }
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Crouch_Shot) { FlowState_Crouch_Shot(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Evasive_Edge) { FlowState_Evasive_Edge(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run_KB) { FlowState_Auto_Run_KB(); }
    else if(FlowCurrentState == FLOW_STATE_VM_Speed) { FlowState_VM_Speed(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Basic_) { FlowState_Anti_Recoil_Basic_(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Data Flow ---
    // Weapon Data
    // Weapon data initialization
    if (!WeaponData_Initialized) {
        InitializeWeaponData();
        WeaponData_Initialized = TRUE;
    }

    // --- Gameplay Flow ---
    // Custom
    // Add your main loop code here
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
            combo_run(AutoPing);
        }
    }
    // Crouch Shot
    if(CrouchShotStatus) {
        if (CrouchShotStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            if (!combo_running(CrouchShot)) {
                combo_run(CrouchShot);
            }
        }
    }
    // Evasive Edge
    if(EvasiveEdgeStatus) {
        if (EvasiveEdgeStatus && get_val(PS5_R2) > 50) {
            if (abs(get_val(PS5_LY)) > 20 || abs(get_val(PS5_LX)) > 20) {
                combo_stop(EvasiveEdge);
            } else {
                combo_run(EvasiveEdge);
            }
        }
    }
    // Keyboard
    if(KeyboardStatus) {
        // Keyboard-to-controller mapping
        if (KeyboardStatus) {
            ApplyKeyboard();
        }
    }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
            set_val(PS5_L3, 100);
        }
    }
    // VM Speed
    ApplyVMSpeed();
    // Custom
    // Add your main loop code here
    // Quick Toggle: Anti Recoil (Basic)
    if(GetKeyboardKey(KEY_MINUS) && _qt_delay_antirecoil <= 0) { AntiRecoilStatus = !AntiRecoilStatus; _qt_delay_antirecoil = 30; FlowRedraw = TRUE; }
    if(_qt_delay_antirecoil > 0) { _qt_delay_antirecoil--; }
    // Anti Recoil (Basic)
    if(AntiRecoilStatus) {
        // Sync V/H proxy vars with per-weapon array
        _ar_cur_weapon = GetActiveWeapon();
        if (_ar_cur_weapon != _ar_prev_weapon) {
            Weapons_RecoilValues[_ar_prev_weapon * 2] = AR_Vertical;
            Weapons_RecoilValues[_ar_prev_weapon * 2 + 1] = AR_Horizontal;
            AR_Vertical = Weapons_RecoilValues[_ar_cur_weapon * 2];
            AR_Horizontal = Weapons_RecoilValues[_ar_cur_weapon * 2 + 1];
            _ar_prev_weapon = _ar_cur_weapon;
        }
        Weapons_RecoilValues[_ar_cur_weapon * 2] = AR_Vertical;
        Weapons_RecoilValues[_ar_cur_weapon * 2 + 1] = AR_Horizontal;
        
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            AntiRecoil_Timer++;
            if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
                combo_run(AntiRecoil);
            }
        } else {
            AntiRecoil_Timer = 0;
        }
    }
    // Quick Toggle: Rapid Fire
    if(GetKeyboardKey(KEY_EQUAL) && _qt_delay_rapid <= 0) { RapidFireStatus = !RapidFireStatus; _qt_delay_rapid = 30; FlowRedraw = TRUE; }
    if(_qt_delay_rapid > 0) { _qt_delay_rapid--; }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && (RapidFireHipFire || get_val(PS5_L2))) {
            combo_run(RapidFire);
        } else {
            combo_stop(RapidFire);
        }
    }
    // Auto Run KB
    if(AutoRunKBStatus) {
        if (AutoRunKBStatus) {
            if (GetKeyboardKey(AUTORUNKB_ACTIVATE_KEY)) {
                AutoRunKBActive = 1;
            }
            if (AutoRunKBActive) {
                if (GetKeyboardKey(KEY_W) || GetKeyboardKey(KEY_A) ||
                    GetKeyboardKey(KEY_S) || GetKeyboardKey(KEY_D)) {
                    AutoRunKBActive = 0;
                } else {
                    set_val(PS5_LY, -100);
                }
            }
        }
    }
}