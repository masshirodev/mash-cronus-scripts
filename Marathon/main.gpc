        if(event_press(PS5_RIGHT) && AlwaysRunThreshold < 100) { AlwaysRunThreshold = AlwaysRunThreshold + 1; FlowRedraw = TRUE; }
        if(event_press(PS5_L1) && AlwaysRunThreshold > 50) { AlwaysRunThreshold = AlwaysRunThreshold - 10; if(AlwaysRunThreshold < 50) AlwaysRunThreshold = 50; FlowRedraw = TRUE; }
        if(event_press(PS5_R1) && AlwaysRunThreshold < 100) { AlwaysRunThreshold = AlwaysRunThreshold + 10; if(AlwaysRunThreshold > 100) AlwaysRunThreshold = 100; FlowRedraw = TRUE; }
