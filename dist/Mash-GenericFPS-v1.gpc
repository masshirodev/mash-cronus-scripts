    }
    if(Flow_Module_Settings_cursor == 5 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Hold_Breath;
    }
    if(Flow_Module_Settings_cursor == 6 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Lean_Spam;
    }
    if(Flow_Module_Settings_cursor == 7 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Rapid_Fire;
    }
    if(Flow_Module_Settings_cursor == 8 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Always_Run;
    }
    if(Flow_Module_Settings_cursor == 9 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Run;
    }
    if(Flow_Module_Settings_cursor == 10 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Run_KB;
    }
    if(Flow_Module_Settings_cursor == 11 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Strafe;
    }
}

// ===== STATE: Aim Assist (Polar) =====
function FlowState_Aim_Assist_Polar_() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Aim_Assist_Polar__cursor > 0) { Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Aim_Assist_Polar__cursor < 2) { Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Aim_Assist_Polar__cursor == 0 && event_press(PS5_CROSS)) { AimPolarStatus = !AimPolarStatus; FlowRedraw = TRUE; }

    // Value adjust: Size
    if(Flow_Aim_Assist_Polar__cursor == 1) {
        if(event_press(PS5_LEFT) && AimPolarSize > 1) { AimPolarSize = AimPolarSize - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSize < 30) { AimPolarSize = AimPolarSize + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: Speed
    if(Flow_Aim_Assist_Polar__cursor == 2) {
        if(event_press(PS5_LEFT) && AimPolarSpeed > 5) { AimPolarSpeed = AimPolarSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSpeed < 50) { AimPolarSpeed = AimPolarSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Aim_Assist_Polar__cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[2]);
        if(AimPolarStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[1]);
        // Value: Size (index 1)
        if(Flow_Aim_Assist_Polar__cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[4]);
        PrintNumber(AimPolarSize, find_digits(AimPolarSize), 104, 8, OLED_FONT_SMALL);
        // Value: Speed (index 2)
        if(Flow_Aim_Assist_Polar__cursor == 2) print(0, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[5]);
        PrintNumber(AimPolarSpeed, find_digits(AimPolarSpeed), 104, 16, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }
    if(AimPolarStatus != _prev_AimPolarStatus) { _prev_AimPolarStatus = AimPolarStatus; FlowRedraw = TRUE; }
    if(AutoPingStatus != _prev_AutoPingStatus) { _prev_AutoPingStatus = AutoPingStatus; FlowRedraw = TRUE; }
    if(BunnyHopStatus != _prev_BunnyHopStatus) { _prev_BunnyHopStatus = BunnyHopStatus; FlowRedraw = TRUE; }
    if(CrouchShotStatus != _prev_CrouchShotStatus) { _prev_CrouchShotStatus = CrouchShotStatus; FlowRedraw = TRUE; }
    if(HoldBreathStatus != _prev_HoldBreathStatus) { _prev_HoldBreathStatus = HoldBreathStatus; FlowRedraw = TRUE; }
    if(LeanSpamStatus != _prev_LeanSpamStatus) { _prev_LeanSpamStatus = LeanSpamStatus; FlowRedraw = TRUE; }
    if(AlwaysRunStatus != _prev_AlwaysRunStatus) { _prev_AlwaysRunStatus = AlwaysRunStatus; FlowRedraw = TRUE; }
    if(AutoRunStatus != _prev_AutoRunStatus) { _prev_AutoRunStatus = AutoRunStatus; FlowRedraw = TRUE; }
    if(AutoRunKBStatus != _prev_AutoRunKBStatus) { _prev_AutoRunKBStatus = AutoRunKBStatus; FlowRedraw = TRUE; }
    if(StrafeStatus != _prev_StrafeStatus) { _prev_StrafeStatus = StrafeStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(55, 18, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(55, 25, TRUE, TRUE, Flow_States_img2[0]); }
        // Pixel Art: Aim Assist Status (conditional)
        if(AimPolarStatus == 1) { image_oled(55, 32, TRUE, TRUE, Flow_States_img3[0]); }
        // Pixel Art: Auto Ping Status (conditional)
        if(AutoPingStatus == 1) { image_oled(55, 39, TRUE, TRUE, Flow_States_img4[0]); }
        // Pixel Art: Bunny Hop Status (conditional)
        if(BunnyHopStatus == 1) { image_oled(55, 46, TRUE, TRUE, Flow_States_img5[0]); }
        // Pixel Art: Crouch Shot Status (conditional)
        if(CrouchShotStatus == 1) { image_oled(55, 53, TRUE, TRUE, Flow_States_img6[0]); }
        // Pixel Art: Hold Breath Status (conditional)
        if(HoldBreathStatus == 1) { image_oled(117, 18, TRUE, TRUE, Flow_States_img7[0]); }
        // Pixel Art: Lean Spam Status (conditional)
        if(LeanSpamStatus == 1) { image_oled(117, 25, TRUE, TRUE, Flow_States_img8[0]); }
        // Pixel Art: Always Run Status (conditional)
        if(AlwaysRunStatus == 1) { image_oled(117, 32, TRUE, TRUE, Flow_States_img9[0]); }
        // Pixel Art: Auto Run Status (conditional)
        if(AutoRunStatus == 1) { image_oled(117, 39, TRUE, TRUE, Flow_States_img10[0]); }
        // Pixel Art: Auto Run KBM Status (conditional)
        if(AutoRunKBStatus == 1) { image_oled(117, 46, TRUE, TRUE, Flow_States_img11[0]); }
        // Pixel Art: Strafe Status (conditional)
        if(StrafeStatus == 1) { image_oled(117, 53, TRUE, TRUE, Flow_States_img12[0]); }
        // Custom sub-node (code injected from sub-node renderCode)
