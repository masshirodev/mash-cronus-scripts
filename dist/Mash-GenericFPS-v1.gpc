// ===== STATE: Always Run =====
function FlowState_Always_Run() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Always_Run_cursor > 0) { Flow_Always_Run_cursor = Flow_Always_Run_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Always_Run_cursor < 1) { Flow_Always_Run_cursor = Flow_Always_Run_cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Always_Run_cursor == 0 && event_press(PS5_CROSS)) { AlwaysRunStatus = !AlwaysRunStatus; FlowRedraw = TRUE; }

    // Value adjust: Threshold
    if(Flow_Always_Run_cursor == 1) {
        if(event_press(PS5_LEFT) && AlwaysRunThreshold > 50) { AlwaysRunThreshold = AlwaysRunThreshold - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AlwaysRunThreshold < 100) { AlwaysRunThreshold = AlwaysRunThreshold + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Always_Run_cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[2]);
        if(AlwaysRunStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[1]);
        // Value: Threshold (index 1)
        if(Flow_Always_Run_cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[4]);
        PrintNumber(AlwaysRunThreshold, find_digits(AlwaysRunThreshold), 104, 8, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Auto Run =====
function FlowState_Auto_Run() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Auto_Run_cursor > 0) { Flow_Auto_Run_cursor = Flow_Auto_Run_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Auto_Run_cursor < 1) { Flow_Auto_Run_cursor = Flow_Auto_Run_cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Auto_Run_cursor == 0 && event_press(PS5_CROSS)) { AutoRunStatus = !AutoRunStatus; FlowRedraw = TRUE; }

    // Value adjust: Threshold
    if(Flow_Auto_Run_cursor == 1) {
        if(event_press(PS5_LEFT) && AutoRunThreshold > 50) { AutoRunThreshold = AutoRunThreshold - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AutoRunThreshold < 100) { AutoRunThreshold = AutoRunThreshold + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Auto_Run_cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[2]);
        if(AutoRunStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[1]);
        // Value: Threshold (index 1)
        if(Flow_Auto_Run_cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run[4]);
        PrintNumber(AutoRunThreshold, find_digits(AutoRunThreshold), 104, 8, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Auto Run KB =====
