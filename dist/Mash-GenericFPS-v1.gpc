        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run_KB[2]);
        if(AutoRunKBStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run_KB[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run_KB[1]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
