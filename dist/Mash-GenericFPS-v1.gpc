}

// ===== STATE: Strafe =====
function FlowState_Strafe() {

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Strafe_cursor > 0) { Flow_Strafe_cursor = Flow_Strafe_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Strafe_cursor < 2) { Flow_Strafe_cursor = Flow_Strafe_cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Strafe_cursor == 0 && event_press(PS5_CROSS)) { StrafeStatus = !StrafeStatus; FlowRedraw = TRUE; }

    // Value adjust: Strength
    if(Flow_Strafe_cursor == 1) {
        if(event_press(PS5_LEFT) && StrafeStrength > 1) { StrafeStrength = StrafeStrength - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && StrafeStrength < 100) { StrafeStrength = StrafeStrength + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: Speed
    if(Flow_Strafe_cursor == 2) {
        if(event_press(PS5_LEFT) && StrafeSpeed > 50) { StrafeSpeed = StrafeSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && StrafeSpeed < 300) { StrafeSpeed = StrafeSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Strafe_cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[2]);
        if(StrafeStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[1]);
        // Value: Strength (index 1)
        if(Flow_Strafe_cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[4]);
        PrintNumber(StrafeStrength, find_digits(StrafeStrength), 104, 8, OLED_FONT_SMALL);
        // Value: Speed (index 2)
        if(Flow_Strafe_cursor == 2) print(0, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[3]);
        print(12, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Strafe[5]);
        PrintNumber(StrafeSpeed, find_digits(StrafeSpeed), 104, 16, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== INIT =====
// ===== DATA FUNCTIONS =====
// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon;
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}


// ===== GAMEPLAY COMBOS =====
// Combo: Aim Assist (Polar)
combo AimPolar {
    AimPol_PolarX = get_val(PS5_RX) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_X_AXIS);
    AimPol_PolarY = get_val(PS5_RY) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_Y_AXIS);
    AimPol_Angle = (AimPol_Angle + AimPolarSpeed) % 360;
    set_val(PS5_RX, clamp(AimPol_PolarX, -100, 100));
    set_val(PS5_RY, clamp(AimPol_PolarY, -100, 100));
    wait(10);
}

// Combo: Anti Recoil (Basic)
combo AntiRecoil {
    active_weapon = GetActiveWeapon();

    // Per-weapon recoil values
    Recoil_Vertical = Weapons_RecoilValues[active_weapon * 2];
    Recoil_Horizontal = Weapons_RecoilValues[active_weapon * 2 + 1];

    // Advance LCG seed every cycle for well-distributed variance
    _jitter_seed = (_jitter_seed * 1103515245 + 12345) ^ get_rtime();

    // Per-cycle variance: ±15% of base value, V and H derived independently
    random_variance_v = (abs(_jitter_seed) % 31) - 15;
    random_variance_h = (abs(_jitter_seed / 31) % 23) - 11;

    if (Recoil_Vertical != 0) {
        set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical + (random_variance_v * abs(Recoil_Vertical) / 100), -100, 100));
    }
    if (Recoil_Horizontal != 0) {
        set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal + (random_variance_h * abs(Recoil_Horizontal) / 100), -100, 100));
    }
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Bunny Hop
combo BunnyHop {
    set_val(BUNNYHOP_JUMP_BTN, 100);
    wait(jitter(BunnyHopInterval));
    set_val(BUNNYHOP_JUMP_BTN, 0);
    wait(jitter(BunnyHopInterval));
}

// Combo: Crouch Shot
combo CrouchShot {
    set_val(PS5_CIRCLE, 100);
    wait(jitter(75));
    set_val(PS5_CIRCLE, 0);
    wait(jitter(125));
}

// Combo: Hold Breath
combo HoldBreath {
    set_val(PS5_L3, 100);
    wait(jitter(HoldBreathDuration));
}

// Combo: Lean Spam
combo LeanSpam {
    set_val(LEANSPAM_LEAN_RIGHT_BTN, 100);
    wait(jitter(100));
    set_val(LEANSPAM_LEAN_RIGHT_BTN, 0);
    wait(jitter(LeanSpamSpeed));
    set_val(LEANSPAM_LEAN_LEFT_BTN, 100);
    wait(jitter(100));
    set_val(LEANSPAM_LEAN_LEFT_BTN, 0);
    wait(jitter(LeanSpamSpeed));
}

// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// Combo: Strafe
combo Strafe {
    StrafeActual = (StrafeStrength * 327);
    set_val(PS5_LX, clamp(get_val(PS5_LX) + StrafeActual, -32767, 32767));
    wait(jitter(StrafeSpeed));
    set_val(PS5_LX, clamp(get_val(PS5_LX) - StrafeActual, -32767, 32767));
    wait(jitter(StrafeSpeed));
}

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Aim Assist (Polar)
define AIMPOL_X_AXIS = 0;
define AIMPOL_Y_AXIS = 1;
function AimPol_ToCart(angle_, radius_, axis_) {
    set_polar2(POLAR_GHOST, angle_, radius_ * 100);
    if (axis_ == AIMPOL_X_AXIS) {
        return get_val(ANALOG_GHOSTX);
    }
    return get_val(ANALOG_GHOSTY);
}

// Functions: Anti Recoil (Basic)
define ANTIRECOIL_INIT_DELAY = 15;  // Skip first ~150ms of firing (minimal recoil)


// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;
int _bp_loop_i;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(AimPolarStatus, -32768, 32767);
    save_spvar(AimPolarSize, 1, 30);
    save_spvar(AimPolarSpeed, 5, 50);
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(BunnyHopStatus, -32768, 32767);
    save_spvar(BunnyHopInterval, 20, 200);
    save_spvar(CrouchShotStatus, -32768, 32767);
    save_spvar(HoldBreathStatus, -32768, 32767);
    save_spvar(HoldBreathDuration, 1000, 30000);
    save_spvar(LeanSpamStatus, -32768, 32767);
    save_spvar(LeanSpamSpeed, 20, 500);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoRunStatus, -32768, 32767);
    save_spvar(AutoRunThreshold, 50, 100);
    save_spvar(AutoRunKBStatus, -32768, 32767);
    save_spvar(StrafeStatus, -32768, 32767);
    save_spvar(StrafeStrength, 1, 100);
    save_spvar(StrafeSpeed, 50, 300);
    save_spvar(CurrentWeapon, 0, 255);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        save_spvar(Weapons_RecoilValues[_bp_loop_i], -100, 100);
    }
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    AimPolarStatus = read_spvar(-32768, 32767, 0);
    AimPolarSize = read_spvar(1, 30, 15);
    AimPolarSpeed = read_spvar(5, 50, 20);
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    BunnyHopStatus = read_spvar(-32768, 32767, 0);
    BunnyHopInterval = read_spvar(20, 200, 50);
    CrouchShotStatus = read_spvar(-32768, 32767, 0);
    HoldBreathStatus = read_spvar(-32768, 32767, 0);
    HoldBreathDuration = read_spvar(1000, 30000, 10000);
    LeanSpamStatus = read_spvar(-32768, 32767, 0);
    LeanSpamSpeed = read_spvar(20, 500, 100);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 5);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoRunStatus = read_spvar(-32768, 32767, 0);
    AutoRunThreshold = read_spvar(50, 100, 80);
    AutoRunKBStatus = read_spvar(-32768, 32767, 0);
    StrafeStatus = read_spvar(-32768, 32767, 0);
    StrafeStrength = read_spvar(1, 100, 50);
    StrafeSpeed = read_spvar(50, 300, 100);
    CurrentWeapon = read_spvar(0, 255, 0);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        Weapons_RecoilValues[_bp_loop_i] = read_spvar(-100, 100, 0);
    }
}

// ===== INIT =====
init {
    FlowCurrentState = FLOW_STATE_Home;
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Aim_Assist_Polar_) { FlowState_Aim_Assist_Polar_(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Basic_) { FlowState_Anti_Recoil_Basic_(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Bunny_Hop) { FlowState_Bunny_Hop(); }
    else if(FlowCurrentState == FLOW_STATE_Crouch_Shot) { FlowState_Crouch_Shot(); }
    else if(FlowCurrentState == FLOW_STATE_Hold_Breath) { FlowState_Hold_Breath(); }
    else if(FlowCurrentState == FLOW_STATE_Lean_Spam) { FlowState_Lean_Spam(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run) { FlowState_Auto_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run_KB) { FlowState_Auto_Run_KB(); }
    else if(FlowCurrentState == FLOW_STATE_Strafe) { FlowState_Strafe(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Data Flow ---
    // Weapon Data
    // Weapon data initialization
    if (!WeaponData_Initialized) {
    InitializeWeaponData();
    WeaponData_Initialized = TRUE;
    }

    // --- Gameplay Flow ---
    // Aim Assist (Polar)
    if(AimPolarStatus) {
        if (AimPolarStatus && get_val(PS5_L2)) {
        combo_run(AimPolar);
        }
    }
    // Anti Recoil (Basic)
    if(AntiRecoilStatus) {
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
        AntiRecoil_Timer++;
        if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
        combo_run(AntiRecoil);
        }
        } else {
        AntiRecoil_Timer = 0;
        }
    }
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
        combo_run(AutoPing);
        }
    }
    // Bunny Hop
    if(BunnyHopStatus) {
        if (BunnyHopStatus && get_val(BUNNYHOP_JUMP_KEY)) {
        combo_run(BunnyHop);
        }
    }
    // Crouch Shot
    if(CrouchShotStatus) {
        if (CrouchShotStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
        if (!combo_running(CrouchShot)) {
        combo_run(CrouchShot);
        }
        }
    }
    // Hold Breath
    if(HoldBreathStatus) {
        if (HoldBreathStatus && get_val(PS5_L2)) {
        if (!combo_running(HoldBreath)) {
        combo_run(HoldBreath);
        }
        }
        if (HoldBreathStatus && !get_val(PS5_L2)) {
        combo_stop(HoldBreath);
        }
    }
    // Lean Spam
    if(LeanSpamStatus) {
        if (LeanSpamStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
        combo_run(LeanSpam);
        }
        if (!get_val(PS5_R2) && combo_running(LeanSpam)) {
        combo_stop(LeanSpam);
        }
    }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && get_val(PS5_L2)) {
        combo_run(RapidFire);
        } else {
        combo_stop(RapidFire);
        }
    }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
        set_val(PS5_L3, 100);
        }
    }
    // Auto Run
    if(AutoRunStatus) {
        if (AutoRunStatus) {
        _lx = get_val(PS5_LX);
        _ly = get_val(PS5_LY);
        _mag = isqrt(_lx * _lx + _ly * _ly);
        if (_mag > AutoRunThreshold) {
        AutoRunLX = _lx * 100 / _mag;
        AutoRunLY = _ly * 100 / _mag;
        AutoRunActive = 1;
        } else if (_mag < 20) {
        AutoRunActive = 0;
        }
        if (AutoRunActive) {
        set_val(PS5_LX, AutoRunLX);
        set_val(PS5_LY, AutoRunLY);
        }
        }
    }
    // Auto Run KB
    if(AutoRunKBStatus) {
        if (AutoRunKBStatus) {
        if (GetKeyboardKey(AUTORUNKB_ACTIVATE_KEY)) {
        AutoRunKBActive = 1;
        }
        if (AutoRunKBActive) {
        if (GetKeyboardKey(KEY_W) || GetKeyboardKey(KEY_A) ||
        GetKeyboardKey(KEY_S) || GetKeyboardKey(KEY_D)) {
        AutoRunKBActive = 0;
        } else {
        set_val(PS5_LY, -100);
        }
        }
        }
    }
    // Strafe
    if(StrafeStatus) {
        if (StrafeStatus && get_val(PS5_R2)) {
        if (abs(get_val(PS5_LX)) > 70 || abs(get_val(PS5_LY)) > 70) {
        combo_stop(Strafe);
        } else {
        combo_run(Strafe);
        }
        }
        if (!get_val(PS5_R2) && combo_running(Strafe)) {
        combo_stop(Strafe);
        }
    }
}
