}

// ===== STATE: Anti Recoil (Basic) =====
function FlowState_Anti_Recoil_Basic_() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Anti_Recoil_Basic__cursor > 0) { Flow_Anti_Recoil_Basic__cursor = Flow_Anti_Recoil_Basic__cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Anti_Recoil_Basic__cursor < 2) { Flow_Anti_Recoil_Basic__cursor = Flow_Anti_Recoil_Basic__cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Anti_Recoil_Basic__cursor == 0 && event_press(PS5_CROSS)) { AntiRecoilStatus = !AntiRecoilStatus; FlowRedraw = TRUE; }

    // Value adjust: V Mod.
    if(Flow_Anti_Recoil_Basic__cursor == 1) {
        if(event_press(PS5_LEFT) && AR_TempV > -100) { AR_TempV = AR_TempV - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AR_TempV < 100) { AR_TempV = AR_TempV + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: H Mod.
    if(Flow_Anti_Recoil_Basic__cursor == 2) {
        if(event_press(PS5_LEFT) && AR_TempH > -100) { AR_TempH = AR_TempH - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AR_TempH < 100) { AR_TempH = AR_TempH + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Anti_Recoil_Basic__cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[2]);
        if(AntiRecoilStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[1]);
        // Value: V Mod. (index 1)
        if(Flow_Anti_Recoil_Basic__cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[4]);
        PrintNumber(AR_TempV, find_digits(AR_TempV), 104, 8, OLED_FONT_SMALL);
        // Value: H Mod. (index 2)
        if(Flow_Anti_Recoil_Basic__cursor == 2) print(0, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[3]);
        print(12, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Basic_[5]);
        PrintNumber(AR_TempH, find_digits(AR_TempH), 104, 16, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

