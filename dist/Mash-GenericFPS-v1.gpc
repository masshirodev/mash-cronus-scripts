    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Auto_Run_KB_cursor > 0) { Flow_Auto_Run_KB_cursor = Flow_Auto_Run_KB_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Auto_Run_KB_cursor < 0) { Flow_Auto_Run_KB_cursor = Flow_Auto_Run_KB_cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Auto_Run_KB_cursor == 0 && event_press(PS5_CROSS)) { AutoRunKBStatus = !AutoRunKBStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
