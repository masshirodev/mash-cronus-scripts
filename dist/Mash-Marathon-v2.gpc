// ===== STATE: VM Speed =====
function FlowState_VM_Speed() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_VM_Speed_cursor > 0) { Flow_VM_Speed_cursor = Flow_VM_Speed_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_VM_Speed_cursor < 0) { Flow_VM_Speed_cursor = Flow_VM_Speed_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_VM_Speed_cursor < Flow_VM_Speed_scroll) Flow_VM_Speed_scroll = Flow_VM_Speed_cursor;
    if(Flow_VM_Speed_cursor >= Flow_VM_Speed_scroll + 5) Flow_VM_Speed_scroll = Flow_VM_Speed_cursor - 5 + 1;

    // Array cycle: Array
    if(Flow_VM_Speed_cursor == 0) {
        if(event_press(PS5_LEFT)) { VMSpeedIndex--; if(VMSpeedIndex < 0) VMSpeedIndex = 4; FlowRedraw = TRUE; ApplyVMSpeed(); }
        if(event_press(PS5_RIGHT)) { VMSpeedIndex++; if(VMSpeedIndex > 4) VMSpeedIndex = 0; FlowRedraw = TRUE; ApplyVMSpeed(); }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_VM_Speed_scroll * 8;
        if(0 >= Flow_VM_Speed_scroll && 0 < Flow_VM_Speed_scroll + 5) {
            // Array: Array (index 0)
            if(Flow_VM_Speed_cursor == 0) {
                rect_oled(13, (7 - _oled_y_off), 115, 8, 1, OLED_WHITE);
                print(15, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_BLACK, VMSpeedLabels[VMSpeedIndex]);
            } else {
                print(15, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, VMSpeedLabels[VMSpeedIndex]);
            }
        }
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== INIT =====
// ===== DATA FUNCTIONS =====
// Weapon names
const string Weapons[] = { "OVERRUN", "V75 SCAR", "IMPACT H-AR", "M77", "RETALIATOR", "DEMOLITION", "CONQUEST", "HARDLINE", "REPEATER", "V66 LOOKOUT", "BR33", "TWIN TAP", "STRYDER", "V11 PUNCH", "CE TACTICAL", "MAGNUM", "V00 ZEUS", "ARES", "MISRIAH", "V85 CIRCUIT", "WSTR", "OUTLAND", "V99 CHANNEL", "LONGSHOT", "COPPERHEAD", "BULLY", "V22 VOLT", "BRRT" };

// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon;
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}


// ===== GAMEPLAY COMBOS =====
// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// Combo: Keyboard
function ApplyKeyboard() {
    if (GetKeyboardKey(KEY_F)) { combo_run(ExecuteUltimate); }
}

// Combo: Custom
combo ExecuteUltimate {
    set_val(PS5_R1, 100);
    wait(40);
    set_val(PS5_L1, 100);
    wait(40);
    set_val(PS5_R1, 0);
    set_val(PS5_L1, 0);
}

// Combo: Aim Assist (Circular)
combo AimCircular {
    set_val(PS5_RX, clamp(get_val(PS5_RX) + (AimCirc_X[AimCirc_Index] * AimCircularSize / 100), -100, 100));
    set_val(PS5_RY, clamp(get_val(PS5_RY) + (AimCirc_Y[AimCirc_Index] * AimCircularSize / 100), -100, 100));
    AimCirc_Index = (AimCirc_Index + 1 + AimCircularSpeed) % AIMCIRC_STEPS;
    wait(10);
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Anti Recoil (Basic)
combo AntiRecoil {
    active_weapon = GetActiveWeapon();

    // Per-weapon recoil values
    Recoil_Vertical = Weapons_RecoilValues[active_weapon * 2];
    Recoil_Horizontal = Weapons_RecoilValues[active_weapon * 2 + 1];

    // Advance LCG seed every cycle for well-distributed variance
    _jitter_seed = (_jitter_seed * 1103515245 + 12345) ^ get_rtime();

    // Per-cycle variance: ±15% of base value, V and H derived independently
    random_variance_v = (abs(_jitter_seed) % 31) - 15;
    random_variance_h = (abs(_jitter_seed / 31) % 23) - 11;

    if (Recoil_Vertical != 0) {
        set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical + (random_variance_v * abs(Recoil_Vertical) / 100), -100, 100));
    }
    if (Recoil_Horizontal != 0) {
        set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal + (random_variance_h * abs(Recoil_Horizontal) / 100), -100, 100));
    }
}

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Custom
// Add your functions here

// Functions: Aim Assist (Circular)
const int8 AimCirc_X[] = {
     0,   9,  17,  26,  34,  43,  50,  58,  64,  70,  76,  81,
    85,  88,  91,  94,  96,  97,  98,  98,  97,  96,  94,  91,
    88,  85,  81,  76,  70,  64,  58,  50,  43,  34,  26,  17,
     9,   0,  -9, -17, -26, -34, -43, -50, -58, -64, -70, -76,
   -81, -85, -88, -91, -94, -96, -97, -98, -98, -97, -96, -94,
   -91, -88, -85, -81, -76, -70, -64, -58, -50, -43, -34, -26,
   -17,  -9
};

const int8 AimCirc_Y[] = {
   100,  99,  98,  96,  94,  91,  88,  85,  81,  76,  70,  64,
    58,  50,  43,  34,  26,  17,   9,   0,  -9, -17, -26, -34,
   -43, -50, -58, -64, -70, -76, -81, -85, -88, -91, -94, -96,
   -98, -99,-100, -99, -98, -96, -94, -91, -88, -85, -81, -76,
   -70, -64, -58, -50, -43, -34, -26, -17,  -9,   0,   9,  17,
    26,  34,  43,  50,  58,  64,  70,  76,  81,  85,  88,  91,
    94,  96
};

define AIMCIRC_STEPS = 72;

// Functions: Anti Recoil (Basic)
define ANTIRECOIL_INIT_DELAY = 15;  // Skip first ~150ms of firing (minimal recoil)

// Functions: VM Speed
const string VMSpeedLabels[] = { "10ms", "8ms", "4ms", "2ms", "1ms" };

function ApplyVMSpeed() {
	if (VMSpeedIndex == 0) { vm_tctrl(0); } 	  // 10ms Default
	else if (VMSpeedIndex == 1) { vm_tctrl(-2); } // 8ms Xbox One
	else if (VMSpeedIndex == 2) { vm_tctrl(-6); } // 4ms PS4/PS5
	else if (VMSpeedIndex == 3) { vm_tctrl(-8); } // 2ms Xbox X/S
	else if (VMSpeedIndex == 4) { vm_tctrl(-9); } // 1ms PC
}


// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;
int _bp_loop_i;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(KeyboardStatus, -32768, 32767);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(AimCircularStatus, -32768, 32767);
    save_spvar(AimCircularSize, 1, 30);
    save_spvar(AimCircularSpeed, 0, 5);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoRunKBStatus, -32768, 32767);
    save_spvar(CurrentWeapon, 0, 255);
    save_spvar(VMSpeedIndex, 0, 4);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        save_spvar(Weapons_RecoilValues[_bp_loop_i], -100, 100);
    }
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    KeyboardStatus = read_spvar(-32768, 32767, 0);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 5);
    AimCircularStatus = read_spvar(-32768, 32767, 0);
    AimCircularSize = read_spvar(1, 30, 15);
    AimCircularSpeed = read_spvar(0, 5, 1);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoRunKBStatus = read_spvar(-32768, 32767, 0);
    CurrentWeapon = read_spvar(0, 255, 0);
    VMSpeedIndex = read_spvar(0, 4, 2);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        Weapons_RecoilValues[_bp_loop_i] = read_spvar(-100, 100, 0);
    }
}

// ===== INIT =====
init {
    // --- Menu Init ---
    FlowCurrentState = FLOW_STATE_Home;

    // --- Gameplay Init ---
    // Init: VM Speed
    ApplyVMSpeed();
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Aim_Assist_Circular_) { FlowState_Aim_Assist_Circular_(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Basic_) { FlowState_Anti_Recoil_Basic_(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run_KB) { FlowState_Auto_Run_KB(); }
    else if(FlowCurrentState == FLOW_STATE_VM_Speed) { FlowState_VM_Speed(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Data Flow ---
    // Weapon Data
    // Weapon data initialization
    if (!WeaponData_Initialized) {
        InitializeWeaponData();
        WeaponData_Initialized = TRUE;
    }

    // --- Gameplay Flow ---
    // Quick Toggle: Rapid Fire
    if(GetKeyboardKey(KEY_EQUAL) && _qt_delay_rapid <= 0) { RapidFireStatus = !RapidFireStatus; _qt_delay_rapid = 30; FlowRedraw = TRUE; }
    if(_qt_delay_rapid > 0) { _qt_delay_rapid--; }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && get_val(PS5_L2)) {
            combo_run(RapidFire);
        } else {
            combo_stop(RapidFire);
        }
    }
    // Keyboard
    if(KeyboardStatus) {
        // Keyboard-to-controller mapping
        if (KeyboardStatus) {
            ApplyKeyboard();
        }
    }
    // Custom
    // Add your main loop code here
    // Aim Assist (Circular)
    if(AimCircularStatus) {
        if (AimCircularStatus && get_val(PS5_L2)) {
            combo_run(AimCircular);
        }
    }
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
            combo_run(AutoPing);
        }
    }
    // Quick Toggle: Anti Recoil (Basic)
    if(GetKeyboardKey(KEY_MINUS) && _qt_delay_antirecoil <= 0) { AntiRecoilStatus = !AntiRecoilStatus; _qt_delay_antirecoil = 30; FlowRedraw = TRUE; }
    if(_qt_delay_antirecoil > 0) { _qt_delay_antirecoil--; }
    // Anti Recoil (Basic)
    if(AntiRecoilStatus) {
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            AntiRecoil_Timer++;
            if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
                combo_run(AntiRecoil);
            }
        } else {
            AntiRecoil_Timer = 0;
        }
    }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
            set_val(PS5_L3, 100);
        }
    }
    // Auto Run KB
    if(AutoRunKBStatus) {
        if (AutoRunKBStatus) {
            if (GetKeyboardKey(AUTORUNKB_ACTIVATE_KEY)) {
                AutoRunKBActive = 1;
            }
            if (AutoRunKBActive) {
                if (GetKeyboardKey(KEY_W) || GetKeyboardKey(KEY_A) ||
                    GetKeyboardKey(KEY_S) || GetKeyboardKey(KEY_D)) {
                    AutoRunKBActive = 0;
                } else {
                    set_val(PS5_LY, -100);
                }
            }
        }
    }
    // VM Speed
    ApplyVMSpeed();
}
