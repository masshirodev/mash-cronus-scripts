// ===== STATE: Rapid Fire =====
function FlowState_Rapid_Fire() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Rapid_Fire_cursor > 0) { Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Rapid_Fire_cursor < 1) { Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Rapid_Fire_cursor < Flow_Rapid_Fire_scroll) Flow_Rapid_Fire_scroll = Flow_Rapid_Fire_cursor;
    if(Flow_Rapid_Fire_cursor >= Flow_Rapid_Fire_scroll + 5) Flow_Rapid_Fire_scroll = Flow_Rapid_Fire_cursor - 5 + 1;
    if(Flow_Rapid_Fire_cursor == 0 && event_press(PS5_CROSS)) { RapidFireStatus = !RapidFireStatus; FlowRedraw = TRUE; }

    // Value adjust: Value
    if(Flow_Rapid_Fire_cursor == 1) {
        if(event_press(PS5_LEFT) && RapidFireSpeed > 1) { RapidFireSpeed = RapidFireSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && RapidFireSpeed < 10) { RapidFireSpeed = RapidFireSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Rapid_Fire_scroll * 8;
        if(0 >= Flow_Rapid_Fire_scroll && 0 < Flow_Rapid_Fire_scroll + 5) {
            // Toggle: Toggle (index 0)
            if(Flow_Rapid_Fire_cursor == 0) print(13, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
            if(RapidFireStatus) print(110, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[0]);
            else print(110, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[1]);
        }
        if(1 >= Flow_Rapid_Fire_scroll && 1 < Flow_Rapid_Fire_scroll + 5) {
            // Value: Value (index 1)
            if(Flow_Rapid_Fire_cursor == 1) print(13, (15 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
            PrintNumber(RapidFireSpeed, find_digits(RapidFireSpeed), 104, (15 - _oled_y_off), OLED_FONT_SMALL);
        }
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(AimCircularStatus != _prev_AimCircularStatus) { _prev_AimCircularStatus = AimCircularStatus; FlowRedraw = TRUE; }
    if(AutoPingStatus != _prev_AutoPingStatus) { _prev_AutoPingStatus = AutoPingStatus; FlowRedraw = TRUE; }
    if(AlwaysRunStatus != _prev_AlwaysRunStatus) { _prev_AlwaysRunStatus = AlwaysRunStatus; FlowRedraw = TRUE; }
    if(AutoRunKBStatus != _prev_AutoRunKBStatus) { _prev_AutoRunKBStatus = AutoRunKBStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(48, 25, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(48, 18, TRUE, TRUE, Flow_States_img2[0]); }
        // Pixel Art: Aim Assist Status (conditional)
        if(AimCircularStatus == 1) { image_oled(48, 32, TRUE, TRUE, Flow_States_img3[0]); }
        // Pixel Art: Auto Ping Status (conditional)
        if(AutoPingStatus == 1) { image_oled(48, 39, TRUE, TRUE, Flow_States_img4[0]); }
        // Pixel Art: Always Run Status (conditional)
        if(AlwaysRunStatus == 1) { image_oled(48, 46, TRUE, TRUE, Flow_States_img5[0]); }
        // Pixel Art: Auto Run Status (conditional)
        if(AutoRunKBStatus == 1) { image_oled(48, 53, TRUE, TRUE, Flow_States_img6[0]); }
        print(47, 4, OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon]);
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Aim Assist (Circular) =====
function FlowState_Aim_Assist_Circular_() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Aim_Assist_Circular__cursor > 0) { Flow_Aim_Assist_Circular__cursor = Flow_Aim_Assist_Circular__cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Aim_Assist_Circular__cursor < 2) { Flow_Aim_Assist_Circular__cursor = Flow_Aim_Assist_Circular__cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Aim_Assist_Circular__cursor < Flow_Aim_Assist_Circular__scroll) Flow_Aim_Assist_Circular__scroll = Flow_Aim_Assist_Circular__cursor;
    if(Flow_Aim_Assist_Circular__cursor >= Flow_Aim_Assist_Circular__scroll + 5) Flow_Aim_Assist_Circular__scroll = Flow_Aim_Assist_Circular__cursor - 5 + 1;
    if(Flow_Aim_Assist_Circular__cursor == 0 && event_press(PS5_CROSS)) { AimCircularStatus = !AimCircularStatus; FlowRedraw = TRUE; }

    // Value adjust: Value
    if(Flow_Aim_Assist_Circular__cursor == 1) {
        if(event_press(PS5_LEFT) && AimCircularSize > 1) { AimCircularSize = AimCircularSize - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimCircularSize < 30) { AimCircularSize = AimCircularSize + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: Value
    if(Flow_Aim_Assist_Circular__cursor == 2) {
        if(event_press(PS5_LEFT) && AimCircularSpeed > 0) { AimCircularSpeed = AimCircularSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimCircularSpeed < 5) { AimCircularSpeed = AimCircularSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Aim_Assist_Circular__scroll * 8;
        if(0 >= Flow_Aim_Assist_Circular__scroll && 0 < Flow_Aim_Assist_Circular__scroll + 5) {
            // Toggle: Toggle (index 0)
            if(Flow_Aim_Assist_Circular__cursor == 0) print(13, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Circular_[3]);
            if(AimCircularStatus) print(110, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Circular_[0]);
            else print(110, (7 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Circular_[1]);
        }
        if(1 >= Flow_Aim_Assist_Circular__scroll && 1 < Flow_Aim_Assist_Circular__scroll + 5) {
            // Value: Value (index 1)
            if(Flow_Aim_Assist_Circular__cursor == 1) print(13, (15 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Circular_[3]);
            PrintNumber(AimCircularSize, find_digits(AimCircularSize), 104, (15 - _oled_y_off), OLED_FONT_SMALL);
        }
        if(2 >= Flow_Aim_Assist_Circular__scroll && 2 < Flow_Aim_Assist_Circular__scroll + 5) {
            // Value: Value (index 2)
            if(Flow_Aim_Assist_Circular__cursor == 2) print(13, (23 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Circular_[3]);
            PrintNumber(AimCircularSpeed, find_digits(AimCircularSpeed), 104, (23 - _oled_y_off), OLED_FONT_SMALL);
        }
    }

    // Back button
