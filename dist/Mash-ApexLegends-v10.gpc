// ===== STATE: Module Settings =====
function FlowState_Module_Settings() {

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Module_Settings_cursor < 9) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Menu Item: Anti Recoil (index 0)
        if(Flow_Module_Settings_cursor == 0) {
            print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
        // Menu Item: Aim AssistPolar)Polar)Polar) (index 1)
        if(Flow_Module_Settings_cursor == 1) {
            print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
        // Menu Item: Auto Ping (index 2)
        if(Flow_Module_Settings_cursor == 2) {
            print(0, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
        // Menu Item: Bunny Hop (index 3)
        if(Flow_Module_Settings_cursor == 3) {
            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 24, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[4]);
        // Menu Item: Drop Shot (index 4)
        if(Flow_Module_Settings_cursor == 4) {
            print(0, 32, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 32, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[5]);
        // Menu Item: Keyboard (index 5)
        if(Flow_Module_Settings_cursor == 5) {
            print(0, 40, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 40, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[6]);
        // Menu Item: Rapid Fire (index 6)
        if(Flow_Module_Settings_cursor == 6) {
            print(0, 48, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 48, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[7]);
        // Menu Item: Always Run (index 7)
        if(Flow_Module_Settings_cursor == 7) {
            print(0, 56, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 56, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[8]);
        // Menu Item: Auto Run (index 8)
        if(Flow_Module_Settings_cursor == 8) {
            print(0, 64, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 64, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[9]);
        // Menu Item: Recoil Debug (index 9)
        if(Flow_Module_Settings_cursor == 9) {
            print(0, 72, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 72, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[10]);
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 0 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Anti_Recoil_Timeline_;
    }
    if(Flow_Module_Settings_cursor == 1 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Aim_Assist_Polar_;
    }
    if(Flow_Module_Settings_cursor == 2 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Ping;
    }
    if(Flow_Module_Settings_cursor == 3 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Bunny_Hop;
    }
    if(Flow_Module_Settings_cursor == 4 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Drop_Shot;
    }
    if(Flow_Module_Settings_cursor == 5 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Keyboard;
    }
    if(Flow_Module_Settings_cursor == 6 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Rapid_Fire;
    }
    if(Flow_Module_Settings_cursor == 7 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Always_Run;
    }
    if(Flow_Module_Settings_cursor == 8 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Run_KB;
    }
    if(Flow_Module_Settings_cursor == 9 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Recoil_Debug;
    }
}

// ===== STATE: Home =====
function FlowState_Home() {

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_Home_img0[0]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(FlowStateTimer > 3000) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_States;
    }
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Anti Recoil (Timeline) =====
function FlowState_Anti_Recoil_Timeline_() {

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Anti_Recoil_Timeline__cursor > 0) { Flow_Anti_Recoil_Timeline__cursor = Flow_Anti_Recoil_Timeline__cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Anti_Recoil_Timeline__cursor < 0) { Flow_Anti_Recoil_Timeline__cursor = Flow_Anti_Recoil_Timeline__cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Anti_Recoil_Timeline__cursor == 0 && event_press(PS5_CROSS)) { AntiRecoilStatus = !AntiRecoilStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Anti_Recoil_Timeline__cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[2]);
        if(AntiRecoilStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[1]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Recoil Debug =====
function FlowState_Recoil_Debug() {
    // On enter
    if(FlowEntered) {
        FlowEntered = FALSE;
        LoadRecoilPhases(active_weapon);
        TLDebug_Phase = 0;
        TLDebug_V = _recoil_phase_v[0];
        TLDebug_H = _recoil_phase_h[0];
    }

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Recoil_Debug_cursor > 0) { Flow_Recoil_Debug_cursor = Flow_Recoil_Debug_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Recoil_Debug_cursor < 2) { Flow_Recoil_Debug_cursor = Flow_Recoil_Debug_cursor + 1; FlowRedraw = TRUE; }

    // Value adjust: Phase
    if(Flow_Recoil_Debug_cursor == 0) {
        if(event_press(PS5_LEFT) && TLDebug_Phase > 0) { TLDebug_Phase = TLDebug_Phase - 1; FlowRedraw = TRUE; TLDebug_V = _recoil_phase_v[TLDebug_Phase]; TLDebug_H = _recoil_phase_h[TLDebug_Phase]; }
        if(event_press(PS5_RIGHT) && TLDebug_Phase < 9) { TLDebug_Phase = TLDebug_Phase + 1; FlowRedraw = TRUE; TLDebug_V = _recoil_phase_v[TLDebug_Phase]; TLDebug_H = _recoil_phase_h[TLDebug_Phase]; }
    }
    // Value adjust: Vertical
    if(Flow_Recoil_Debug_cursor == 1) {
        if(event_press(PS5_LEFT) && TLDebug_V > -100) { TLDebug_V = TLDebug_V - 1; FlowRedraw = TRUE; _recoil_phase_v[TLDebug_Phase] = TLDebug_V; }
        if(event_press(PS5_RIGHT) && TLDebug_V < 100) { TLDebug_V = TLDebug_V + 1; FlowRedraw = TRUE; _recoil_phase_v[TLDebug_Phase] = TLDebug_V; }
    }
    // Value adjust: Horizontal
    if(Flow_Recoil_Debug_cursor == 2) {
        if(event_press(PS5_LEFT) && TLDebug_H > -100) { TLDebug_H = TLDebug_H - 1; FlowRedraw = TRUE; _recoil_phase_h[TLDebug_Phase] = TLDebug_H; }
        if(event_press(PS5_RIGHT) && TLDebug_H < 100) { TLDebug_H = TLDebug_H + 1; FlowRedraw = TRUE; _recoil_phase_h[TLDebug_Phase] = TLDebug_H; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Header: RECOIL DEBUG
        print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[0]);
        line_oled(0, 8, 127, 8, 1, OLED_WHITE);
        // Value: Phase (index 0)
        if(Flow_Recoil_Debug_cursor == 0) {
            rect_oled(0, 10, 128, 8, 1, OLED_WHITE);
            print(2, 10, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[1]);
            PrintNumber(TLDebug_Phase, find_digits(TLDebug_Phase), 104, 10, OLED_FONT_SMALL);
        } else {
            print(2, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[1]);
            PrintNumber(TLDebug_Phase, find_digits(TLDebug_Phase), 104, 10, OLED_FONT_SMALL);
        }
        // Value: Vertical (index 1)
        if(Flow_Recoil_Debug_cursor == 1) {
            rect_oled(0, 18, 128, 8, 1, OLED_WHITE);
            print(2, 18, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[2]);
            PrintNumber(TLDebug_V, find_digits(TLDebug_V), 104, 18, OLED_FONT_SMALL);
        } else {
            print(2, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[2]);
            PrintNumber(TLDebug_V, find_digits(TLDebug_V), 104, 18, OLED_FONT_SMALL);
        }
        // Value: Horizontal (index 2)
        if(Flow_Recoil_Debug_cursor == 2) {
            rect_oled(0, 26, 128, 8, 1, OLED_WHITE);
            print(2, 26, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[3]);
            PrintNumber(TLDebug_H, find_digits(TLDebug_H), 104, 26, OLED_FONT_SMALL);
        } else {
            print(2, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[3]);
            PrintNumber(TLDebug_H, find_digits(TLDebug_H), 104, 26, OLED_FONT_SMALL);
        }
    }

    // Custom code
    // Two-way sync: array <-> shadow vars
    if(_recoil_phase_v[TLDebug_Phase] != TLDebug_V) { TLDebug_V = _recoil_phase_v[TLDebug_Phase]; FlowRedraw = TRUE; }
    if(_recoil_phase_h[TLDebug_Phase] != TLDebug_H) { TLDebug_H = _recoil_phase_h[TLDebug_Phase]; FlowRedraw = TRUE; }
    
    // Weapon name
    print(2, 35, OLED_FONT_SMALL, OLED_WHITE, Weapons[active_weapon]);
    
    // Timeline bar chart (V values by phase)
    line_oled(0, 43, 127, 43, OLED_WHITE);
    for(_tld_i = 0; _tld_i < 10; _tld_i++) {
        _tld_bh = abs(_recoil_phase_v[_tld_i]) * 18 / 100;
        if(_tld_bh > 0) {
            rect_oled(_tld_i * 12 + 4, 63 - _tld_bh, 10, _tld_bh, 1, OLED_WHITE);
        }
        // Mark current phase
        if(_tld_i == TLDebug_Phase) {
            rect_oled(_tld_i * 12 + 4, 44, 10, 1, 1, OLED_WHITE);
        }
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Aim Assist (Polar) =====
function FlowState_Aim_Assist_Polar_() {

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Aim_Assist_Polar__cursor > 0) { Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Aim_Assist_Polar__cursor < 2) { Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Aim_Assist_Polar__cursor == 0 && event_press(PS5_CROSS)) { AimPolarStatus = !AimPolarStatus; FlowRedraw = TRUE; }

    // Value adjust: Size
    if(Flow_Aim_Assist_Polar__cursor == 1) {
        if(event_press(PS5_LEFT) && AimPolarSize > 1) { AimPolarSize = AimPolarSize - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSize < 30) { AimPolarSize = AimPolarSize + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: Speed
    if(Flow_Aim_Assist_Polar__cursor == 2) {
        if(event_press(PS5_LEFT) && AimPolarSpeed > 5) { AimPolarSpeed = AimPolarSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSpeed < 50) { AimPolarSpeed = AimPolarSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Aim_Assist_Polar__cursor == 0) print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[2]);
        if(AimPolarStatus) print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[0]);
        else print(110, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[1]);
        // Value: Size (index 1)
        if(Flow_Aim_Assist_Polar__cursor == 1) print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[4]);
        PrintNumber(AimPolarSize, find_digits(AimPolarSize), 104, 8, OLED_FONT_SMALL);
        // Value: Speed (index 2)
        if(Flow_Aim_Assist_Polar__cursor == 2) print(0, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(12, 16, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[5]);
        PrintNumber(AimPolarSpeed, find_digits(AimPolarSpeed), 104, 16, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(48, 18, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(48, 25, TRUE, TRUE, Flow_States_img2[0]); }
        print(47, 4, OLED_FONT_SMALL, OLED_WHITE, FlowText_States[0]);
        print(80, 4, OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon]);
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

