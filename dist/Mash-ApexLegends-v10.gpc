// ===== INIT =====
// ===== DATA FUNCTIONS =====
// Weapon names
const string Weapons[] = { "a", "b", "c" };

// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon;
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}


// ===== GAMEPLAY COMBOS =====
// Combo: Aim Assist (Polar)
combo AimPolar {
    AimPol_PolarX = get_val(PS5_RX) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_X_AXIS);
    AimPol_PolarY = get_val(PS5_RY) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_Y_AXIS);
    AimPol_Angle = (AimPol_Angle + AimPolarSpeed) % 360;
    set_val(PS5_RX, clamp(AimPol_PolarX, -100, 100));
    set_val(PS5_RY, clamp(AimPol_PolarY, -100, 100));
    wait(10);
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Bunny Hop
combo BunnyHop {
    set_val(BUNNYHOP_JUMP_BTN, 100);
    wait(jitter(BunnyHopInterval));
    set_val(BUNNYHOP_JUMP_BTN, 0);
    wait(jitter(BunnyHopInterval));
}

// Combo: Drop Shot
combo DropShot {
    DropShotActive = 1;
    set_val(DROPSHOT_PRONE_BTN, 100);
    wait(jitter(800));
    set_val(DROPSHOT_PRONE_BTN, 0);
    wait(jitter(50));
    set_val(DROPSHOT_STAND_BTN, 100);
    wait(jitter(200));
    set_val(DROPSHOT_STAND_BTN, 0);
    DropShotActive = 0;
    wait(jitter(DropShotRest));
}

// Combo: Keyboard
function ApplyKeyboard() {
    if (GetKeyboardKey(KEY_P)) { set_val(PS5_PS, 100); }
    if (GetKeyboardKey(KEY_O)) { set_val(PS5_SHARE, 100); }
    if (GetKeyboardKey(KEY_LEFTSHIFT)) { set_val(PS5_L3, 100); }
    if (GetKeyboardKey(KEY_SPACE)) { set_val(PS5_CROSS, 100); }
    if (GetKeyboardKey(KEY_C)) { set_val(PS5_CIRCLE, 100); }
    if (GetKeyboardKey(KEY_LEFTCTRL)) { set_val(PS5_CIRCLE, 100); }
    if (GetKeyboardKey(KEY_E)) { set_val(PS5_SQUARE, 100); }
    if (GetKeyboardKey(KEY_R)) { set_val(PS5_SQUARE, 100); }
    if (GetKeyboardKey(KEY_TAB)) { set_val(PS5_OPTIONS, 100); }
    if (GetKeyboardKey(KEY_ESC)) { set_val(PS5_OPTIONS, 100); }
    if (GetKeyboardKey(KEY_M)) { set_val(PS5_TOUCH, 100); }
    if (GetKeyboardKey(KEY_B)) { set_val(PS5_LEFT, 100); }
    if (GetKeyboardKey(KEY_V)) { set_val(PS5_R3, 100); }
    if (GetKeyboardKey(KEY_1)) { set_val(PS5_TRIANGLE, 100); }
    if (GetKeyboardKey(KEY_2)) { set_val(PS5_TRIANGLE, 100); }
    if (GetKeyboardKey(KEY_G)) { set_val(PS5_RIGHT, 100); }
    if (GetKeyboardKey(KEY_Q)) { set_val(PS5_UP, 100); }
    if (GetKeyboardKey(KEY_H)) { set_val(PS5_DOWN, 100); }
    if (GetKeyboardKey(KEY_CAPSLOCK)) { set_val(PS5_L1, 100); }
}

// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Aim Assist (Polar)
define AIMPOL_X_AXIS = 0;
define AIMPOL_Y_AXIS = 1;
function AimPol_ToCart(angle_, radius_, axis_) {
    set_polar2(POLAR_GHOST, angle_, radius_ * 100);
    if (axis_ == AIMPOL_X_AXIS) {
        return get_val(ANALOG_GHOSTX);
    }
    return get_val(ANALOG_GHOSTY);
}

// Functions: Weapon Detection
define ADP_DETECT_DELAY = 10;
const string WaitingText[] = {"Waiting..."};
function CheckADPWeapon() {
    if (CurrentWeapon != 0) {
        ADP_DetectTimer = 0;
        ADP_LastDetected = -1;
        return;
    }

    if (get_adt(PS5_R2, PS5_ADT_MODE) == PS5_ADT_OFF) {
        return;
    }

    detected = -1;

    // INJECT_ADP_CHECKS_HERE

    if (detected > 0) {
        if (detected == ADP_LastDetected) {
            ADP_DetectTimer++;
            if (ADP_DetectTimer >= ADP_DETECT_DELAY) {
                ADP_DetectedWeapon = detected;
                DrewStates = FALSE;
            }
        } else {
            ADP_LastDetected = detected;
            ADP_DetectTimer = 0;
        }
    }
}

function GetActiveWeapon() {
    if (CurrentWeapon == 0) {
        return ADP_DetectedWeapon;
    }
    return CurrentWeapon;
}

// Adaptive trigger signatures per weapon
// Format: Mode, Start, F1, F2, StrLow, StrMid, StrHigh, 0, 0, Freq, 0
const uint8 ADP_Values[][] = {
//   Mode  Start  F1    F2   StrL  StrM  StrH   0  0  Freq  0
    { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0, 0, 0x00, 0 },  // 0: Automatic
};

// Functions: Anti Recoil (Timeline)
define RECOIL_PHASES = 10;
define RECOIL_PHASE_STEP = 18;
define ANTIRECOIL_INIT_DELAY = 1;
function LoadRecoilPhases(weapon_id) {
    for (_current_phase = 0; _current_phase < RECOIL_PHASES; _current_phase++) {
        _recoil_phase_v[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2];
        _recoil_phase_h[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2 + 1];
    }
    for (_current_phase = 1; _current_phase < RECOIL_PHASES; _current_phase++) {
        if (_recoil_phase_v[_current_phase] == 0 && _recoil_phase_v[_current_phase - 1] != 0) {
            _recoil_phase_v[_current_phase] = _recoil_phase_v[_current_phase - 1];
        }
        if (_recoil_phase_h[_current_phase] == 0 && _recoil_phase_h[_current_phase - 1] != 0) {
            _recoil_phase_h[_current_phase] = _recoil_phase_h[_current_phase - 1];
        }
    }
    _last_recoil_weapon = weapon_id;
}


// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;
int _bp_loop_i;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(AimPolarStatus, -32768, 32767);
    save_spvar(AimPolarSize, 1, 30);
    save_spvar(AimPolarSpeed, 5, 50);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(BunnyHopStatus, -32768, 32767);
    save_spvar(BunnyHopInterval, 20, 200);
    save_spvar(DropShotStatus, -32768, 32767);
    save_spvar(DropShotRest, 100, 1000);
    save_spvar(KeyboardStatus, -32768, 32767);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoRunKBStatus, -32768, 32767);
    save_spvar(Adp_Enabled, -32768, 32767);
    save_spvar(CurrentWeapon, 0, 255);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        save_spvar(Weapons_RecoilValues[_bp_loop_i], -100, 100);
    }
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    AimPolarStatus = read_spvar(-32768, 32767, 0);
    AimPolarSize = read_spvar(1, 30, 15);
    AimPolarSpeed = read_spvar(5, 50, 20);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    BunnyHopStatus = read_spvar(-32768, 32767, 0);
    BunnyHopInterval = read_spvar(20, 200, 50);
    DropShotStatus = read_spvar(-32768, 32767, 0);
    DropShotRest = read_spvar(100, 1000, 500);
    KeyboardStatus = read_spvar(-32768, 32767, 0);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 5);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoRunKBStatus = read_spvar(-32768, 32767, 0);
    Adp_Enabled = read_spvar(-32768, 32767, 0);
    CurrentWeapon = read_spvar(0, 255, 0);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT * 2; _bp_loop_i++) {
        Weapons_RecoilValues[_bp_loop_i] = read_spvar(-100, 100, 0);
    }
}

// ===== INIT =====
init {
    FlowCurrentState = FLOW_STATE_Module_Settings;
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Timeline_) { FlowState_Anti_Recoil_Timeline_(); }
    else if(FlowCurrentState == FLOW_STATE_Recoil_Debug) { FlowState_Recoil_Debug(); }
    else if(FlowCurrentState == FLOW_STATE_Aim_Assist_Polar_) { FlowState_Aim_Assist_Polar_(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Bunny_Hop) { FlowState_Bunny_Hop(); }
    else if(FlowCurrentState == FLOW_STATE_Drop_Shot) { FlowState_Drop_Shot(); }
    else if(FlowCurrentState == FLOW_STATE_Keyboard) { FlowState_Keyboard(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run_KB) { FlowState_Auto_Run_KB(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Data Flow ---
    // Profile Data
    // Weapon Data
    // Weapon data initialization
    if (!WeaponData_Initialized) {
        InitializeWeaponData();
        WeaponData_Initialized = TRUE;
    }

    // --- Gameplay Flow ---
    // Aim Assist (Polar)
    if(AimPolarStatus) {
        if (AimPolarStatus && get_val(PS5_L2)) {
            combo_run(AimPolar);
        }
    }
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
            combo_run(AutoPing);
        }
    }
    // Bunny Hop
    if(BunnyHopStatus) {
        if (BunnyHopStatus && get_val(BUNNYHOP_JUMP_KEY)) {
            combo_run(BunnyHop);
        }
    }
    // Drop Shot
    if(DropShotStatus) {
        if (DropShotStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
            if (!DropShotActive) {
                combo_run(DropShot);
            }
        }
    }
    // Keyboard
    if(KeyboardStatus) {
        // Keyboard-to-controller mapping
        if (KeyboardStatus) {
            ApplyKeyboard();
        }
    }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && get_val(PS5_L2)) {
            combo_run(RapidFire);
        } else {
            combo_stop(RapidFire);
        }
    }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
            set_val(PS5_L3, 100);
        }
    }
    // Auto Run KB
    if(AutoRunKBStatus) {
        if (AutoRunKBStatus) {
            if (GetKeyboardKey(AUTORUNKB_ACTIVATE_KEY)) {
                AutoRunKBActive = 1;
            }
            if (AutoRunKBActive) {
                if (GetKeyboardKey(KEY_W) || GetKeyboardKey(KEY_A) ||
                    GetKeyboardKey(KEY_S) || GetKeyboardKey(KEY_D)) {
                    AutoRunKBActive = 0;
                } else {
                    set_val(PS5_LY, -100);
                }
            }
        }
    }
    // Weapon Detection
    if(Adp_Enabled) {
        // ADP weapon detection (runs every cycle when in Auto mode)
        CheckADPWeapon();
    }
    // Anti Recoil (Timeline)
    if(AntiRecoilStatus) {
        // Anti-recoil (phase-based) with per-weapon recoil curves
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            AntiRecoil_Timer++;
            if (AntiRecoil_Timer == 1) {
                active_weapon = GetActiveWeapon();
                if (active_weapon != _last_recoil_weapon) {
                    LoadRecoilPhases(active_weapon);
                }
            }
            if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
                _current_phase = AntiRecoil_Timer / RECOIL_PHASE_STEP;
                if (_current_phase >= RECOIL_PHASES) _current_phase = RECOIL_PHASES - 1;
                Recoil_Vertical = _recoil_phase_v[_current_phase];
                Recoil_Horizontal = _recoil_phase_h[_current_phase];
                if (Recoil_Vertical == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_v[_ar_i] != 0) { Recoil_Vertical = _recoil_phase_v[_ar_i]; _ar_i = 0; } } }
                if (Recoil_Horizontal == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_h[_ar_i] != 0) { Recoil_Horizontal = _recoil_phase_h[_ar_i]; _ar_i = 0; } } }
                Recoil_Vertical = Recoil_Vertical + Weapons_RecoilValues[active_weapon * 2];
                Recoil_Horizontal = Recoil_Horizontal + Weapons_RecoilValues[active_weapon * 2 + 1];
                set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical, -100, 100));
                set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal, -100, 100));
            }
        } else {
            AntiRecoil_Timer = 0;
        }
    }
}
