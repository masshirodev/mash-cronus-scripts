    if(event_press(PS5_UP) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Module_Settings_cursor < 1) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Menu Item: Anti Recoil (Timeline) (index 0)
        if(Flow_Module_Settings_cursor == 0) {
            print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
        // Menu Item: Menu Item (index 1)
        if(Flow_Module_Settings_cursor == 1) {
            print(0, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(12, 8, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 0 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Anti_Recoil_Timeline_;
    }
    if(event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Recoil_Debug;
    }
}

