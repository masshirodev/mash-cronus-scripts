// ===== STATE: Module Settings =====
function FlowState_Module_Settings() {

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Module_Settings_cursor < 6) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Module_Settings_cursor < Flow_Module_Settings_scroll) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor;
    if(Flow_Module_Settings_cursor >= Flow_Module_Settings_scroll + 4) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor - 4 + 1;

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Menu Item: Aim Assist (index 0)
        if(Flow_Module_Settings_cursor == 0) {
            print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
        // Menu Item: Always Run (index 1)
        if(Flow_Module_Settings_cursor == 1) {
            print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
        // Menu Item: Anti Recoil (index 2)
        if(Flow_Module_Settings_cursor == 2) {
            print(15, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
        // Menu Item: Auto Ping (index 3)
        if(Flow_Module_Settings_cursor == 3) {
            print(15, 34, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 34, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[4]);
        // Menu Item: Auto Run (index 4)
        if(Flow_Module_Settings_cursor == 4) {
            print(15, 42, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 42, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[5]);
        // Menu Item: Keyboard (index 5)
        if(Flow_Module_Settings_cursor == 5) {
            print(15, 50, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 50, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[6]);
        // Menu Item: Rapid Fire (index 6)
        if(Flow_Module_Settings_cursor == 6) {
            print(15, 58, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        print(27, 58, OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[7]);
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 0 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Aim_Assist_Polar_;
    }
    if(Flow_Module_Settings_cursor == 1 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Always_Run;
    }
    if(Flow_Module_Settings_cursor == 2 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Anti_Recoil_Timeline_;
    }
    if(Flow_Module_Settings_cursor == 3 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Ping;
    }
    if(Flow_Module_Settings_cursor == 4 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Run_KB;
    }
    if(Flow_Module_Settings_cursor == 5 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Keyboard;
    }
    if(Flow_Module_Settings_cursor == 6 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Rapid_Fire;
    }
}

// ===== STATE: Aim Assist (Polar) =====
function FlowState_Aim_Assist_Polar_() {

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Aim_Assist_Polar__cursor > 0) Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor - 1; else Flow_Aim_Assist_Polar__cursor = 2; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Aim_Assist_Polar__cursor < 2) Flow_Aim_Assist_Polar__cursor = Flow_Aim_Assist_Polar__cursor + 1; else Flow_Aim_Assist_Polar__cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Aim_Assist_Polar__cursor == 0 && event_press(PS5_CROSS)) { AimPolarStatus = !AimPolarStatus; FlowRedraw = TRUE; }

    // Value adjust: Size
    if(Flow_Aim_Assist_Polar__cursor == 1) {
        if(event_press(PS5_LEFT) && AimPolarSize > 1) { AimPolarSize = AimPolarSize - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSize < 30) { AimPolarSize = AimPolarSize + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: Speed
    if(Flow_Aim_Assist_Polar__cursor == 2) {
        if(event_press(PS5_LEFT) && AimPolarSpeed > 5) { AimPolarSpeed = AimPolarSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AimPolarSpeed < 50) { AimPolarSpeed = AimPolarSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Aim_Assist_Polar__cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[2]);
        if(AimPolarStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[1]);
        // Value: Size (index 1)
        if(Flow_Aim_Assist_Polar__cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[4]);
        PrintNumber(AimPolarSize, find_digits(AimPolarSize), 104, 18, OLED_FONT_SMALL);
        // Value: Speed (index 2)
        if(Flow_Aim_Assist_Polar__cursor == 2) print(15, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[3]);
        print(27, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Aim_Assist_Polar_[5]);
        PrintNumber(AimPolarSpeed, find_digits(AimPolarSpeed), 104, 26, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Home =====
function FlowState_Home() {

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_Home_img0[0]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
    if(FlowStateTimer > 3000) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_States;
    }
}

