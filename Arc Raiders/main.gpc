// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(48, 18, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(48, 25, TRUE, TRUE, Flow_States_img2[0]); }
        print(47, 4, OLED_FONT_SMALL, OLED_WHITE, FlowText_States[0]);
        print(80, 4, OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon]);
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Anti Recoil (Timeline) =====
function FlowState_Anti_Recoil_Timeline_() {

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Anti_Recoil_Timeline__cursor > 0) Flow_Anti_Recoil_Timeline__cursor = Flow_Anti_Recoil_Timeline__cursor - 1; else Flow_Anti_Recoil_Timeline__cursor = 2; FlowRedraw = TRUE; }
