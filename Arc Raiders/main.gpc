        if(AutoRunKBStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run_KB[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Run_KB[1]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Keyboard =====
function FlowState_Keyboard() {

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Keyboard_cursor > 0) Flow_Keyboard_cursor = Flow_Keyboard_cursor - 1; else Flow_Keyboard_cursor = 0; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Keyboard_cursor < 0) Flow_Keyboard_cursor = Flow_Keyboard_cursor + 1; else Flow_Keyboard_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Keyboard_cursor == 0 && event_press(PS5_CROSS)) { KeyboardStatus = !KeyboardStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Keyboard_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Keyboard[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Keyboard[2]);
        if(KeyboardStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Keyboard[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Keyboard[1]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Rapid Fire =====
function FlowState_Rapid_Fire() {

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Rapid_Fire_cursor > 0) Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor - 1; else Flow_Rapid_Fire_cursor = 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Rapid_Fire_cursor < 1) Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor + 1; else Flow_Rapid_Fire_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Rapid_Fire_cursor == 0 && event_press(PS5_CROSS)) { RapidFireStatus = !RapidFireStatus; FlowRedraw = TRUE; }

    // Value adjust: Speed
    if(Flow_Rapid_Fire_cursor == 1) {
        if(event_press(PS5_LEFT) && RapidFireSpeed > 1) { RapidFireSpeed = RapidFireSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && RapidFireSpeed < 10) { RapidFireSpeed = RapidFireSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Rapid_Fire_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[2]);
        if(RapidFireStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[1]);
        // Value: Speed (index 1)
        if(Flow_Rapid_Fire_cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[4]);
        PrintNumber(RapidFireSpeed, find_digits(RapidFireSpeed), 104, 18, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== INIT =====
// ===== GAMEPLAY COMBOS =====
// Combo: Aim Assist (Polar)
combo AimPolar {
    AimPol_PolarX = get_val(PS5_RX) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_X_AXIS);
    AimPol_PolarY = get_val(PS5_RY) + AimPol_ToCart(AimPol_Angle, AimPolarSize, AIMPOL_Y_AXIS);
    AimPol_Angle = (AimPol_Angle + AimPolarSpeed) % 360;
    set_val(PS5_RX, clamp(AimPol_PolarX, -100, 100));
    set_val(PS5_RY, clamp(AimPol_PolarY, -100, 100));
    wait(10);
}

// Combo: Anti Recoil (Timeline)
combo AntiRecoilTimeline {
    active_weapon = GetActiveWeapon();

    // Load phase data when weapon changes
    if (active_weapon != _last_recoil_weapon) {
        LoadRecoilPhases(active_weapon);
    }

    // Determine current phase from fire timer
    _current_phase = GetRecoilPhase(AntiRecoil_Timer);

    // Phase recoil + per-weapon menu modifier
    Recoil_Vertical = _recoil_phase_v[_current_phase] + Weapons_RecoilValues[active_weapon * 2];
    Recoil_Horizontal = _recoil_phase_h[_current_phase] + Weapons_RecoilValues[active_weapon * 2 + 1];

    // Advance LCG seed every cycle for well-distributed variance
    _jitter_seed = (_jitter_seed * 1103515245 + 12345) ^ get_rtime();

    // Per-cycle variance: +/-15% of base value, V and H derived independently
    random_variance_v = (abs(_jitter_seed) % 31) - 15;
    random_variance_h = (abs(_jitter_seed / 31) % 23) - 11;

    // Apply recoil correction with randomness
    if (Recoil_Vertical != 0) {
        set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical + (random_variance_v * abs(Recoil_Vertical) / 100), -100, 100));
    }
    if (Recoil_Horizontal != 0) {
        set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal + (random_variance_h * abs(Recoil_Horizontal) / 100), -100, 100));
    }
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Keyboard
function ApplyKeyboard() {
    if (GetKeyboardKey(KEY_P)) { set_val(PS5_PS, 100); }
    if (GetKeyboardKey(KEY_O)) { set_val(PS5_SHARE, 100); }
    if (GetKeyboardKey(KEY_LEFTSHIFT)) { set_val(PS5_L3, 100); }
    if (GetKeyboardKey(KEY_Q)) { set_val(PS5_L1, 100); }
    if (GetKeyboardKey(KEY_SPACE)) { set_val(PS5_CROSS, 100); }
    if (GetKeyboardKey(KEY_C)) { set_val(PS5_CIRCLE, 100); }
    if (GetKeyboardKey(KEY_1)) { set_val(PS5_TRIANGLE, 100); }
    if (GetKeyboardKey(KEY_R)) { set_val(PS5_SQUARE, 100); }
    if (GetKeyboardKey(KEY_E)) { set_val(PS5_SQUARE, 100); }
    if (GetKeyboardKey(KEY_G)) { set_val(PS5_UP, 100); }
    if (GetKeyboardKey(KEY_Z)) { set_val(PS5_DOWN, 100); }
    if (GetKeyboardKey(KEY_2)) { set_val(PS5_LEFT, 100); }
    if (GetKeyboardKey(KEY_F)) { set_val(PS5_RIGHT, 100); }
    if (GetKeyboardKey(KEY_M)) { set_val(PS5_TOUCH, 100); }
    if (GetKeyboardKey(KEY_TAB)) { set_val(PS5_TOUCH, 100); }
    if (GetKeyboardKey(KEY_ESC)) { set_val(PS5_OPTIONS, 100); }
}

// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Aim Assist (Polar)
define AIMPOL_X_AXIS = 0;
define AIMPOL_Y_AXIS = 1;
function AimPol_ToCart(angle_, radius_, axis_) {
    set_polar2(POLAR_GHOST, angle_, radius_ * 100);
    if (axis_ == AIMPOL_X_AXIS) {
        return get_val(ANALOG_GHOSTX);
    }
    return get_val(ANALOG_GHOSTY);
}

// Weapon names
const string Weapons[] = { "a", "b", "c" };

// Weapon recoil table — loaded from recoiltable.gpc
#include "recoiltable.gpc"

// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon;
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}

// Functions: Anti Recoil (Timeline)
define RECOIL_PHASES = 10;
define RECOIL_PHASE_0_END = 8;
define RECOIL_PHASE_1_END = 16;
define RECOIL_PHASE_2_END = 28;
define RECOIL_PHASE_3_END = 42;
define RECOIL_PHASE_4_END = 60;
define RECOIL_PHASE_5_END = 80;
define RECOIL_PHASE_6_END = 105;
define RECOIL_PHASE_7_END = 135;
define RECOIL_PHASE_8_END = 175;
define ANTIRECOIL_INIT_DELAY = 15;  // Skip first ~150ms of firing (minimal recoil)
function GetRecoilPhase(fireTime) {
    if (fireTime <= RECOIL_PHASE_0_END) { return 0; }
    if (fireTime <= RECOIL_PHASE_1_END) { return 1; }
    if (fireTime <= RECOIL_PHASE_2_END) { return 2; }
    if (fireTime <= RECOIL_PHASE_3_END) { return 3; }
    if (fireTime <= RECOIL_PHASE_4_END) { return 4; }
    if (fireTime <= RECOIL_PHASE_5_END) { return 5; }
    if (fireTime <= RECOIL_PHASE_6_END) { return 6; }
    if (fireTime <= RECOIL_PHASE_7_END) { return 7; }
    if (fireTime <= RECOIL_PHASE_8_END) { return 8; }
    return 9;
}

function LoadRecoilPhases(weapon_id) {
    for (_current_phase = 0; _current_phase < RECOIL_PHASES; _current_phase++) {
        _recoil_phase_v[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2];
        _recoil_phase_h[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2 + 1];
    }
    // Carry-forward: if phase N is 0 and phase N-1 is non-zero, inherit
    for (_current_phase = 1; _current_phase < RECOIL_PHASES; _current_phase++) {
        if (_recoil_phase_v[_current_phase] == 0 && _recoil_phase_v[_current_phase - 1] != 0) {
            _recoil_phase_v[_current_phase] = _recoil_phase_v[_current_phase - 1];
        }
        if (_recoil_phase_h[_current_phase] == 0 && _recoil_phase_h[_current_phase - 1] != 0) {
            _recoil_phase_h[_current_phase] = _recoil_phase_h[_current_phase - 1];
        }
    }
    _last_recoil_weapon = weapon_id;
}


// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(AimPolarStatus, -32768, 32767);
    save_spvar(AimPolarSize, 1, 30);
    save_spvar(AimPolarSpeed, 5, 50);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(Weapondata_Enabled, -32768, 32767);
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(AutoRunKBStatus, -32768, 32767);
    save_spvar(KeyboardStatus, -32768, 32767);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(CurrentWeapon, 0, 255);
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    AimPolarStatus = read_spvar(-32768, 32767, 0);
    AimPolarSize = read_spvar(1, 30, 15);
    AimPolarSpeed = read_spvar(5, 50, 20);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    Weapondata_Enabled = read_spvar(-32768, 32767, 0);
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    AutoRunKBStatus = read_spvar(-32768, 32767, 0);
    KeyboardStatus = read_spvar(-32768, 32767, 0);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 5);
    CurrentWeapon = read_spvar(0, 255, 0);
}

// ===== INIT =====
init {
    FlowCurrentState = FLOW_STATE_Module_Settings;
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Aim_Assist_Polar_) { FlowState_Aim_Assist_Polar_(); }
    else if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Timeline_) { FlowState_Anti_Recoil_Timeline_(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Run_KB) { FlowState_Auto_Run_KB(); }
    else if(FlowCurrentState == FLOW_STATE_Keyboard) { FlowState_Keyboard(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Gameplay Flow ---
    // Aim Assist (Polar)
    if(AimPolarStatus) {
        if (AimPolarStatus && get_val(PS5_L2)) {
        combo_run(AimPolar);
        }
    }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
        set_val(PS5_L3, 100);
        }
    }
    // Weapon Data
    if(Weapondata_Enabled) {
        // Weapon data initialization
        if (!WeaponData_Initialized) {
        InitializeWeaponData();
        WeaponData_Initialized = TRUE;
        }
    }
    // Anti Recoil (Timeline)
    if(AntiRecoilStatus) {
        // Anti-recoil (phase-based) with per-weapon recoil curves
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
        AntiRecoil_Timer++;
        if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
        combo_run(AntiRecoilTimeline);
        }
        } else {
        AntiRecoil_Timer = 0;
        }
    }
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
        combo_run(AutoPing);
        }
    }
    // Auto Run KB
    if(AutoRunKBStatus) {
        if (AutoRunKBStatus) {
        if (GetKeyboardKey(AUTORUNKB_ACTIVATE_KEY)) {
        AutoRunKBActive = 1;
        }
        if (AutoRunKBActive) {
        if (GetKeyboardKey(KEY_W) || GetKeyboardKey(KEY_A) ||
        GetKeyboardKey(KEY_S) || GetKeyboardKey(KEY_D)) {
        AutoRunKBActive = 0;
        } else {
        set_val(PS5_LY, -100);
        }
        }
        }
    }
    // Keyboard
    if(KeyboardStatus) {
        // Keyboard-to-controller mapping
        if (KeyboardStatus) {
        ApplyKeyboard();
        }
    }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && get_val(PS5_L2)) {
        combo_run(RapidFire);
        } else {
        combo_stop(RapidFire);
        }
    }
}