    if(Flow_Anti_Recoil_Timeline__cursor == 0 && event_press(PS5_CROSS)) { AntiRecoilStatus = !AntiRecoilStatus; FlowRedraw = TRUE; }

    // Value adjust: V Mod.
    if(Flow_Anti_Recoil_Timeline__cursor == 1) {
        if(event_press(PS5_LEFT) && AR_TempV > -100) { AR_TempV = AR_TempV - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AR_TempV < 100) { AR_TempV = AR_TempV + 1; FlowRedraw = TRUE; }
    }
    // Value adjust: H Mod.
    if(Flow_Anti_Recoil_Timeline__cursor == 2) {
        if(event_press(PS5_LEFT) && AR_TempH > -100) { AR_TempH = AR_TempH - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AR_TempH < 100) { AR_TempH = AR_TempH + 1; FlowRedraw = TRUE; }
    }

    // Render
