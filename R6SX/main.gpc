// ===== MENU FLOW =====
// ====================================================
// Flow: Menu Flow
// Generated by ZenForge Flow Editor
// States: 9 | Transitions: 9
// ====================================================

// ===== STATE DEFINITIONS =====
define FLOW_STATE_Splash = 0;
define FLOW_STATE_Module_Settings = 1;
define FLOW_STATE_Anti_Recoil_Timeline_ = 2;
define FLOW_STATE_Rapid_Fire = 3;
define FLOW_STATE_States = 4;
define FLOW_STATE_Always_Run = 5;
define FLOW_STATE_Auto_Ping = 6;
define FLOW_STATE_Recoil_Debug = 7;
define FLOW_STATE_Lean_Spam = 8;

define Flow_Module_Settings_total_items = 9;
define Flow_Module_Settings_visible = 5;

// ===== VARIABLES =====
int FlowCurrentState;
int FlowPrevState = -1;
int FlowStateTimer;
int FlowRedraw = TRUE;
int FlowEntered;
int FlowStateStack[8];
int FlowStackTop = 0;
int _oled_y_off;

// Variables for Module Settings
int Flow_Module_Settings_cursor;
int Flow_Module_Settings_scroll;

// Variables for Anti Recoil (Timeline)
int Flow_Anti_Recoil_Timeline__cursor;

// Variables for Rapid Fire
int Flow_Rapid_Fire_cursor;

// Variables for Always Run
int Flow_Always_Run_cursor;

// Variables for Auto Ping
