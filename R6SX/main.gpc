// Conditional sub-node tracking
int _prev_AntiRecoilStatus;
int _prev_RapidFireStatus;




// ===== STATE: Splash =====
function FlowState_Splash() {

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_Splash_img0[0]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
    if(FlowStateTimer > 3000) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_States;
    }
}

// ===== STATE: Module Settings =====
function FlowState_Module_Settings() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Module_Settings_cursor < 8) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Module_Settings_cursor < Flow_Module_Settings_scroll) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor;
    if(Flow_Module_Settings_cursor >= Flow_Module_Settings_scroll + 5) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor - 5 + 1;

    // Array cycle: Team
    if(Flow_Module_Settings_cursor == 0) {
        if(event_press(PS5_LEFT)) { Flow_CurrentProfile--; if(Flow_CurrentProfile < 0) Flow_CurrentProfile = 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT)) { Flow_CurrentProfile++; if(Flow_CurrentProfile > 1) Flow_CurrentProfile = 0; FlowRedraw = TRUE; }
    }
    // Array cycle: Operator
    if(Flow_Module_Settings_cursor == 1) {
        if(event_press(PS5_LEFT)) { CurrentOperator--; if(CurrentOperator < 0) CurrentOperator = (Operators_RowCounts[Operators] - 1); FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT)) { CurrentOperator++; if(CurrentOperator > (Operators_RowCounts[Operators] - 1)) CurrentOperator = 0; FlowRedraw = TRUE; }
    }
    // Array cycle: Weapon
    if(Flow_Module_Settings_cursor == 2) {
        if(event_press(PS5_LEFT)) { CurrentWeapon--; if(CurrentWeapon < 0) CurrentWeapon = (WEAPON_COUNT - 1); FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT)) { CurrentWeapon++; if(CurrentWeapon > (WEAPON_COUNT - 1)) CurrentWeapon = 0; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Module_Settings_scroll * 8;
        if(0 >= Flow_Module_Settings_scroll && 0 < Flow_Module_Settings_scroll + 5) {
            // Array: Team (index 0)
            if(Flow_Module_Settings_cursor == 0) print(15, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            print(27, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
            print(80, (10 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, ProfileLabels[Flow_CurrentProfile]);
        }
        if(1 >= Flow_Module_Settings_scroll && 1 < Flow_Module_Settings_scroll + 5) {
            // Array: Operator (index 1)
            if(Flow_Module_Settings_cursor == 1) print(15, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            print(27, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
            print(80, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, Operators[Operators_Offsets[Operators] + CurrentOperator]);
        }
        if(2 >= Flow_Module_Settings_scroll && 2 < Flow_Module_Settings_scroll + 5) {
            // Array: Weapon (index 2)
            if(Flow_Module_Settings_cursor == 2) print(15, (26 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            print(27, (26 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            print(80, (26 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon]);
        }
        if(3 >= Flow_Module_Settings_scroll && 3 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Anti Recoil (index 3)
            if(Flow_Module_Settings_cursor == 3) {
                print(15, (34 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (34 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[4]);
        }
        if(4 >= Flow_Module_Settings_scroll && 4 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Rapid Fire (index 4)
            if(Flow_Module_Settings_cursor == 4) {
                print(15, (42 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (42 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[5]);
        }
        if(5 >= Flow_Module_Settings_scroll && 5 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Always Run (index 5)
            if(Flow_Module_Settings_cursor == 5) {
                print(15, (50 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (50 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[6]);
        }
        if(6 >= Flow_Module_Settings_scroll && 6 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Auto Ping (index 6)
            if(Flow_Module_Settings_cursor == 6) {
                print(15, (58 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (58 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[7]);
        }
        if(7 >= Flow_Module_Settings_scroll && 7 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Lean Spam (index 7)
            if(Flow_Module_Settings_cursor == 7) {
                print(15, (66 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (66 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[8]);
        }
        if(8 >= Flow_Module_Settings_scroll && 8 < Flow_Module_Settings_scroll + 5) {
            // Menu Item: Recoil Debug (index 8)
            if(Flow_Module_Settings_cursor == 8) {
                print(15, (74 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
            }
            print(27, (74 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[9]);
        }
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 3 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Anti_Recoil_Timeline_;
    }
    if(Flow_Module_Settings_cursor == 4 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Rapid_Fire;
    }
    if(Flow_Module_Settings_cursor == 5 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Always_Run;
    }
    if(Flow_Module_Settings_cursor == 6 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Auto_Ping;
    }
    if(Flow_Module_Settings_cursor == 7 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Lean_Spam;
    }
    if(Flow_Module_Settings_cursor == 8 && event_press(PS5_CROSS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Recoil_Debug;
    }
}

// ===== STATE: Anti Recoil (Timeline) =====
function FlowState_Anti_Recoil_Timeline_() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Anti_Recoil_Timeline__cursor > 0) Flow_Anti_Recoil_Timeline__cursor = Flow_Anti_Recoil_Timeline__cursor - 1; else Flow_Anti_Recoil_Timeline__cursor = 0; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Anti_Recoil_Timeline__cursor < 0) Flow_Anti_Recoil_Timeline__cursor = Flow_Anti_Recoil_Timeline__cursor + 1; else Flow_Anti_Recoil_Timeline__cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Anti_Recoil_Timeline__cursor == 0 && event_press(PS5_CROSS)) { AntiRecoilStatus = !AntiRecoilStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Anti_Recoil_Timeline__cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[2]);
        if(AntiRecoilStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Anti_Recoil_Timeline_[1]);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Rapid Fire =====
function FlowState_Rapid_Fire() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Rapid_Fire_cursor > 0) Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor - 1; else Flow_Rapid_Fire_cursor = 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Rapid_Fire_cursor < 1) Flow_Rapid_Fire_cursor = Flow_Rapid_Fire_cursor + 1; else Flow_Rapid_Fire_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Rapid_Fire_cursor == 0 && event_press(PS5_CROSS)) { RapidFireStatus = !RapidFireStatus; FlowRedraw = TRUE; }

    // Value adjust: Speed
    if(Flow_Rapid_Fire_cursor == 1) {
        if(event_press(PS5_LEFT) && RapidFireSpeed > 1) { RapidFireSpeed = RapidFireSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && RapidFireSpeed < 10) { RapidFireSpeed = RapidFireSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Rapid_Fire_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[2]);
        if(RapidFireStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[1]);
        // Value: Speed (index 1)
        if(Flow_Rapid_Fire_cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Rapid_Fire[4]);
        PrintNumber(RapidFireSpeed, find_digits(RapidFireSpeed), 104, 18, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(AntiRecoilStatus != _prev_AntiRecoilStatus) { _prev_AntiRecoilStatus = AntiRecoilStatus; FlowRedraw = TRUE; }
    if(RapidFireStatus != _prev_RapidFireStatus) { _prev_RapidFireStatus = RapidFireStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Recoil Status (conditional)
        if(AntiRecoilStatus == 1) { image_oled(48, 18, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Rapid Fire Status (conditional)
        if(RapidFireStatus == 1) { image_oled(48, 25, TRUE, TRUE, Flow_States_img2[0]); }
        print(47, 4, OLED_FONT_SMALL, OLED_WHITE, FlowText_States[0]);
        print(80, 4, OLED_FONT_SMALL, OLED_WHITE, Weapons[CurrentWeapon]);
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(get_val(PS5_L2) && event_press(PS5_OPTIONS)) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Always Run =====
function FlowState_Always_Run() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Always_Run_cursor > 0) Flow_Always_Run_cursor = Flow_Always_Run_cursor - 1; else Flow_Always_Run_cursor = 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Always_Run_cursor < 1) Flow_Always_Run_cursor = Flow_Always_Run_cursor + 1; else Flow_Always_Run_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Always_Run_cursor == 0 && event_press(PS5_CROSS)) { AlwaysRunStatus = !AlwaysRunStatus; FlowRedraw = TRUE; }

    // Value adjust: Threshold
    if(Flow_Always_Run_cursor == 1) {
        if(event_press(PS5_LEFT) && AlwaysRunThreshold > 50) { AlwaysRunThreshold = AlwaysRunThreshold - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AlwaysRunThreshold < 100) { AlwaysRunThreshold = AlwaysRunThreshold + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Always_Run_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[2]);
        if(AlwaysRunStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[1]);
        // Value: Threshold (index 1)
        if(Flow_Always_Run_cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Always_Run[4]);
        PrintNumber(AlwaysRunThreshold, find_digits(AlwaysRunThreshold), 104, 18, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Auto Ping =====
function FlowState_Auto_Ping() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Auto_Ping_cursor > 0) Flow_Auto_Ping_cursor = Flow_Auto_Ping_cursor - 1; else Flow_Auto_Ping_cursor = 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Auto_Ping_cursor < 1) Flow_Auto_Ping_cursor = Flow_Auto_Ping_cursor + 1; else Flow_Auto_Ping_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Auto_Ping_cursor == 0 && event_press(PS5_CROSS)) { AutoPingStatus = !AutoPingStatus; FlowRedraw = TRUE; }

    // Value adjust: Interval
    if(Flow_Auto_Ping_cursor == 1) {
        if(event_press(PS5_LEFT) && AutoPingInterval > 100) { AutoPingInterval = AutoPingInterval - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && AutoPingInterval < 2000) { AutoPingInterval = AutoPingInterval + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Auto_Ping_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[2]);
        if(AutoPingStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[1]);
        // Value: Interval (index 1)
        if(Flow_Auto_Ping_cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Auto_Ping[4]);
        PrintNumber(AutoPingInterval, find_digits(AutoPingInterval), 104, 18, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Recoil Debug =====
function FlowState_Recoil_Debug() {
    // On enter
    if(FlowEntered) {
        FlowEntered = FALSE;
        LoadRecoilPhases(active_weapon);
        TLDebug_Phase = 0;
        TLDebug_V = _recoil_phase_v[0];
        TLDebug_H = _recoil_phase_h[0];
    }

    // Cursor navigation
    if(event_press(PS5_UP) && Flow_Recoil_Debug_cursor > 0) { Flow_Recoil_Debug_cursor = Flow_Recoil_Debug_cursor - 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN) && Flow_Recoil_Debug_cursor < 3) { Flow_Recoil_Debug_cursor = Flow_Recoil_Debug_cursor + 1; FlowRedraw = TRUE; }
    if(Flow_Recoil_Debug_cursor == 3 && event_press(PS5_CROSS)) { TLDebug_Clear = !TLDebug_Clear; FlowRedraw = TRUE; }

    // Value adjust: Phase
    if(Flow_Recoil_Debug_cursor == 0) {
        if(event_press(PS5_LEFT) && TLDebug_Phase > 0) { TLDebug_Phase = TLDebug_Phase - 1; FlowRedraw = TRUE; TLDebug_V = _recoil_phase_v[TLDebug_Phase]; TLDebug_H = _recoil_phase_h[TLDebug_Phase]; }
        if(event_press(PS5_RIGHT) && TLDebug_Phase < 9) { TLDebug_Phase = TLDebug_Phase + 1; FlowRedraw = TRUE; TLDebug_V = _recoil_phase_v[TLDebug_Phase]; TLDebug_H = _recoil_phase_h[TLDebug_Phase]; }
    }
    // Value adjust: Vertical
    if(Flow_Recoil_Debug_cursor == 1) {
        if(event_press(PS5_LEFT) && TLDebug_V > -100) { TLDebug_V = TLDebug_V - 1; FlowRedraw = TRUE; _recoil_phase_v[TLDebug_Phase] = TLDebug_V; }
        if(event_press(PS5_RIGHT) && TLDebug_V < 100) { TLDebug_V = TLDebug_V + 1; FlowRedraw = TRUE; _recoil_phase_v[TLDebug_Phase] = TLDebug_V; }
    }
    // Value adjust: Horizontal
    if(Flow_Recoil_Debug_cursor == 2) {
        if(event_press(PS5_LEFT) && TLDebug_H > -100) { TLDebug_H = TLDebug_H - 1; FlowRedraw = TRUE; _recoil_phase_h[TLDebug_Phase] = TLDebug_H; }
        if(event_press(PS5_RIGHT) && TLDebug_H < 100) { TLDebug_H = TLDebug_H + 1; FlowRedraw = TRUE; _recoil_phase_h[TLDebug_Phase] = TLDebug_H; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Header: RECOIL DEBUG
        print(0, 0, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[0]);
        line_oled(0, 8, 127, 8, 1, OLED_WHITE);
        // Value: Phase (index 0)
        if(Flow_Recoil_Debug_cursor == 0) {
            rect_oled(0, 10, 128, 8, 1, OLED_WHITE);
            print(2, 10, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[1]);
            PrintNumber(TLDebug_Phase, find_digits(TLDebug_Phase), 104, 10, OLED_FONT_SMALL);
        } else {
            print(2, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[1]);
            PrintNumber(TLDebug_Phase, find_digits(TLDebug_Phase), 104, 10, OLED_FONT_SMALL);
        }
        // Value: Vertical (index 1)
        if(Flow_Recoil_Debug_cursor == 1) {
            rect_oled(0, 18, 128, 8, 1, OLED_WHITE);
            print(2, 18, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[2]);
            PrintNumber(TLDebug_V, find_digits(TLDebug_V), 104, 18, OLED_FONT_SMALL);
        } else {
            print(2, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[2]);
            PrintNumber(TLDebug_V, find_digits(TLDebug_V), 104, 18, OLED_FONT_SMALL);
        }
        // Value: Horizontal (index 2)
        if(Flow_Recoil_Debug_cursor == 2) {
            rect_oled(0, 26, 128, 8, 1, OLED_WHITE);
            print(2, 26, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[3]);
            PrintNumber(TLDebug_H, find_digits(TLDebug_H), 104, 26, OLED_FONT_SMALL);
        } else {
            print(2, 26, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[3]);
            PrintNumber(TLDebug_H, find_digits(TLDebug_H), 104, 26, OLED_FONT_SMALL);
        }
        // Toggle: Clear (index 3)
        if(Flow_Recoil_Debug_cursor == 3) {
            rect_oled(0, 34, 128, 8, 1, OLED_WHITE);
            print(2, 34, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[6]);
            if(TLDebug_Clear) print(110, 34, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[4]);
            else print(110, 34, OLED_FONT_SMALL, OLED_BLACK, FlowText_Recoil_Debug[5]);
        } else {
            print(2, 34, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[6]);
            if(TLDebug_Clear) print(110, 34, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[4]);
            else print(110, 34, OLED_FONT_SMALL, OLED_WHITE, FlowText_Recoil_Debug[5]);
        }
    }

    // Custom code
    // Clear all phases
    if(TLDebug_Clear) {
        for(_tld_i = 0; _tld_i < 10; _tld_i++) { _recoil_phase_v[_tld_i] = 0; _recoil_phase_h[_tld_i] = 0; }
        TLDebug_V = 0; TLDebug_H = 0; TLDebug_Clear = FALSE; FlowRedraw = TRUE;
    }
    
    // Two-way sync: array <-> shadow vars
    if(_recoil_phase_v[TLDebug_Phase] != TLDebug_V) { TLDebug_V = _recoil_phase_v[TLDebug_Phase]; FlowRedraw = TRUE; }
    if(_recoil_phase_h[TLDebug_Phase] != TLDebug_H) { TLDebug_H = _recoil_phase_h[TLDebug_Phase]; FlowRedraw = TRUE; }
    
    // Weapon name
    print(2, 35, OLED_FONT_SMALL, OLED_WHITE, Weapons[active_weapon]);
    
    // Timeline bar chart (V values by phase)
    line_oled(0, 43, 127, 43, 1, OLED_WHITE);
    for(_tld_i = 0; _tld_i < 10; _tld_i++) {
        _tld_bh = abs(_recoil_phase_v[_tld_i]) * 18 / 100;
        if(_tld_bh > 0) {
            rect_oled(_tld_i * 12 + 4, 63 - _tld_bh, 10, _tld_bh, 1, OLED_WHITE);
        }
        // Mark current phase
        if(_tld_i == TLDebug_Phase) {
            rect_oled(_tld_i * 12 + 4, 44, 10, 1, 1, OLED_WHITE);
        }
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        LoadRecoilPhases(active_weapon);
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: Lean Spam =====
function FlowState_Lean_Spam() {
    block_all_inputs();

    // Cursor navigation
    if(event_press(PS5_UP)) { if(Flow_Lean_Spam_cursor > 0) Flow_Lean_Spam_cursor = Flow_Lean_Spam_cursor - 1; else Flow_Lean_Spam_cursor = 1; FlowRedraw = TRUE; }
    if(event_press(PS5_DOWN)) { if(Flow_Lean_Spam_cursor < 1) Flow_Lean_Spam_cursor = Flow_Lean_Spam_cursor + 1; else Flow_Lean_Spam_cursor = 0; FlowRedraw = TRUE; }
    if(Flow_Lean_Spam_cursor == 0 && event_press(PS5_CROSS)) { LeanSpamStatus = !LeanSpamStatus; FlowRedraw = TRUE; }

    // Value adjust: Speed
    if(Flow_Lean_Spam_cursor == 1) {
        if(event_press(PS5_LEFT) && LeanSpamSpeed > 20) { LeanSpamSpeed = LeanSpamSpeed - 1; FlowRedraw = TRUE; }
        if(event_press(PS5_RIGHT) && LeanSpamSpeed < 500) { LeanSpamSpeed = LeanSpamSpeed + 1; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Toggle: Status (index 0)
        if(Flow_Lean_Spam_cursor == 0) print(15, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[3]);
        print(27, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[2]);
        if(LeanSpamStatus) print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[0]);
        else print(110, 10, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[1]);
        // Value: Speed (index 1)
        if(Flow_Lean_Spam_cursor == 1) print(15, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[3]);
        print(27, 18, OLED_FONT_SMALL, OLED_WHITE, FlowText_Lean_Spam[4]);
        PrintNumber(LeanSpamSpeed, find_digits(LeanSpamSpeed), 104, 18, OLED_FONT_SMALL);
    }

    // Back button
    if(event_press(PS5_CIRCLE) && FlowStackTop > 0) {
        Flow_Save();
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

