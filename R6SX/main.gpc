// Functions: Weapon Data
function GetActiveWeapon() {
    return CurrentWeapon;
}

function InitializeWeaponData() {
    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {
        Weapons_RecoilValues[weapon_init_idx * 2] = 0;
        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;
    }
}


// ===== GAMEPLAY COMBOS =====
// Combo: Rapid Fire
combo RapidFire {
    RapidFireActualSpeed = RapidFireSpeed * 20;
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 100);
    wait(jitter(RapidFireActualSpeed));
    set_val(PS5_R2, 0);
    wait(jitter(RapidFireActualSpeed));
}

// Combo: Auto Ping
combo AutoPing {
    set_val(AUTOPING_PING_BTN, 100);
    wait(jitter(50));
    set_val(AUTOPING_PING_BTN, 0);
    wait(jitter(AutoPingInterval - 50));
}

// Combo: Lean Spam
combo LeanSpam {
    set_val(LEANSPAM_LEAN_RIGHT_BTN, 100);
    wait(jitter(100));
    set_val(LEANSPAM_LEAN_RIGHT_BTN, 0);
    wait(jitter(LeanSpamSpeed));
    set_val(LEANSPAM_LEAN_LEFT_BTN, 100);
    wait(jitter(100));
    set_val(LEANSPAM_LEAN_LEFT_BTN, 0);
    wait(jitter(LeanSpamSpeed));
}

// ===== GAMEPLAY FUNCTIONS =====
// Functions: Anti Recoil (Timeline)
define RECOIL_PHASES = 10;
define RECOIL_PHASE_STEP = 18;
define ANTIRECOIL_INIT_DELAY = 1;
function LoadRecoilPhases(weapon_id) {
    for (_current_phase = 0; _current_phase < RECOIL_PHASES; _current_phase++) {
        _recoil_phase_v[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2];
        _recoil_phase_h[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2 + 1];
    }
    for (_current_phase = 1; _current_phase < RECOIL_PHASES; _current_phase++) {
        if (_recoil_phase_v[_current_phase] == 0 && _recoil_phase_v[_current_phase - 1] != 0) {
            _recoil_phase_v[_current_phase] = _recoil_phase_v[_current_phase - 1];
        }
        if (_recoil_phase_h[_current_phase] == 0 && _recoil_phase_h[_current_phase - 1] != 0) {
            _recoil_phase_h[_current_phase] = _recoil_phase_h[_current_phase - 1];
        }
    }
    _last_recoil_weapon = weapon_id;
}


// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;
int _bp_loop_i;
int _bp_sparse_count;
int _bp_loop_j;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(AntiRecoilStatus, -32768, 32767);
    save_spvar(AR_TempV, -100, 100);
    save_spvar(AR_TempH, -100, 100);
    save_spvar(LeanSpamStatus, -32768, 32767);
    save_spvar(LeanSpamSpeed, 20, 500);
    save_spvar(RapidFireStatus, -32768, 32767);
    save_spvar(RapidFireSpeed, 1, 10);
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoPingStatus, -32768, 32767);
    save_spvar(AutoPingInterval, 100, 2000);
    save_spvar(KeyboardStatus, -32768, 32767);
    save_spvar(CurrentWeapon, 0, 255);
    save_spvar(CurrentOperator, -32768, 32767);
    save_spvar(CurrentProfile, -32768, 32767);
    _bp_sparse_count = 0;
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT; _bp_loop_i++) {
        if(Weapons_RecoilValues[_bp_loop_i * 2 + 0] != 0 || Weapons_RecoilValues[_bp_loop_i * 2 + 1] != 0) _bp_sparse_count++;
    }
    save_spvar(_bp_sparse_count, 0, WEAPON_COUNT);
    for(_bp_loop_i = 0; _bp_loop_i < WEAPON_COUNT; _bp_loop_i++) {
        if(Weapons_RecoilValues[_bp_loop_i * 2 + 0] != 0 || Weapons_RecoilValues[_bp_loop_i * 2 + 1] != 0) {
            save_spvar(_bp_loop_i, 0, WEAPON_COUNT);
            save_spvar(Weapons_RecoilValues[_bp_loop_i * 2 + 0], -100, 100);
            save_spvar(Weapons_RecoilValues[_bp_loop_i * 2 + 1], -100, 100);
        }
    }
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    AntiRecoilStatus = read_spvar(-32768, 32767, 0);
    AR_TempV = read_spvar(-100, 100, 0);
    AR_TempH = read_spvar(-100, 100, 0);
    LeanSpamStatus = read_spvar(-32768, 32767, 0);
    LeanSpamSpeed = read_spvar(20, 500, 100);
    RapidFireStatus = read_spvar(-32768, 32767, 0);
    RapidFireSpeed = read_spvar(1, 10, 5);
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoPingStatus = read_spvar(-32768, 32767, 0);
    AutoPingInterval = read_spvar(100, 2000, 1000);
    KeyboardStatus = read_spvar(-32768, 32767, 0);
    CurrentWeapon = read_spvar(0, 255, 0);
    CurrentOperator = read_spvar(-32768, 32767, 0);
    CurrentProfile = read_spvar(-32768, 32767, 0);
    _bp_sparse_count = read_spvar(0, WEAPON_COUNT, 0);
    for(_bp_loop_j = 0; _bp_loop_j < _bp_sparse_count; _bp_loop_j++) {
        _bp_loop_i = read_spvar(0, WEAPON_COUNT, 0);
        Weapons_RecoilValues[_bp_loop_i * 2 + 0] = read_spvar(-100, 100, 0);
        Weapons_RecoilValues[_bp_loop_i * 2 + 1] = read_spvar(-100, 100, 0);
    }
}

// ===== INIT =====
init {
    FlowCurrentState = FLOW_STATE_Splash;
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Splash) { FlowState_Splash(); }
    else if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Anti_Recoil_Timeline_) { FlowState_Anti_Recoil_Timeline_(); }
    else if(FlowCurrentState == FLOW_STATE_Rapid_Fire) { FlowState_Rapid_Fire(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Always_Run) { FlowState_Always_Run(); }
    else if(FlowCurrentState == FLOW_STATE_Auto_Ping) { FlowState_Auto_Ping(); }
    else if(FlowCurrentState == FLOW_STATE_Recoil_Debug) { FlowState_Recoil_Debug(); }
    else if(FlowCurrentState == FLOW_STATE_Lean_Spam) { FlowState_Lean_Spam(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();

    // --- Data Flow ---
    // Weapon Data
    // Weapon data initialization
    if (!WeaponData_Initialized) {
        InitializeWeaponData();
        WeaponData_Initialized = TRUE;
    }
    // Array Builder
    // Profile Data

    // --- Gameplay Flow ---
    // Quick Toggle: Rapid Fire
    if(GetKeyboardKey(KEY_MINUS) && _qt_delay_rapid <= 0) { RapidFireStatus = !RapidFireStatus; _qt_delay_rapid = 30; FlowRedraw = TRUE; }
    if(_qt_delay_rapid > 0) { _qt_delay_rapid--; }
    // Rapid Fire
    if(RapidFireStatus) {
        if (RapidFireStatus && get_val(PS5_R2) && get_val(PS5_L2)) {
            combo_run(RapidFire);
        } else {
            combo_stop(RapidFire);
        }
    }
    // Quick Toggle: Always Run
    if(GetKeyboardKey(KEY_8) && _qt_delay_alwaysrun <= 0) { AlwaysRunStatus = !AlwaysRunStatus; _qt_delay_alwaysrun = 30; FlowRedraw = TRUE; }
    if(_qt_delay_alwaysrun > 0) { _qt_delay_alwaysrun--; }
    // Always Run
    if(AlwaysRunStatus) {
        if (AlwaysRunStatus && get_val(PS5_LY) < -AlwaysRunThreshold) {
            set_val(PS5_L3, 100);
        }
    }
    // Quick Toggle: Auto Ping
    if(GetKeyboardKey(KEY_9) && _qt_delay_autoping <= 0) { AutoPingStatus = !AutoPingStatus; _qt_delay_autoping = 30; FlowRedraw = TRUE; }
    if(_qt_delay_autoping > 0) { _qt_delay_autoping--; }
    // Auto Ping
    if(AutoPingStatus) {
        if (AutoPingStatus && get_val(PS5_L2) && event_press(PS5_R2)) {
            combo_run(AutoPing);
        }
    }
    // Quick Toggle: Lean Spam
    if(GetKeyboardKey(KEY_0) && _qt_delay_leanspam <= 0) { LeanSpamStatus = !LeanSpamStatus; _qt_delay_leanspam = 30; FlowRedraw = TRUE; }
    if(_qt_delay_leanspam > 0) { _qt_delay_leanspam--; }
    // Lean Spam
    if(LeanSpamStatus) {
        if (LeanSpamStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            combo_run(LeanSpam);
        }
        if (!get_val(PS5_R2) && combo_running(LeanSpam)) {
            combo_stop(LeanSpam);
        }
    }
    // Quick Toggle: Anti Recoil (Timeline)
    if(GetKeyboardKey(KEY_EQUAL) && _qt_delay_antirecoil_timeline <= 0) { AntiRecoilStatus = !AntiRecoilStatus; _qt_delay_antirecoil_timeline = 30; FlowRedraw = TRUE; }
    if(_qt_delay_antirecoil_timeline > 0) { _qt_delay_antirecoil_timeline--; }
    // Anti Recoil (Timeline)
    if(AntiRecoilStatus) {
        // Anti-recoil (phase-based) with per-weapon recoil curves
        if (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {
            AntiRecoil_Timer++;
            if (AntiRecoil_Timer == 1) {
                active_weapon = GetActiveWeapon();
                if (active_weapon != _last_recoil_weapon) {
                    LoadRecoilPhases(active_weapon);
                }
            }
            if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {
                _current_phase = AntiRecoil_Timer / RECOIL_PHASE_STEP;
                if (_current_phase >= RECOIL_PHASES) _current_phase = RECOIL_PHASES - 1;
                Recoil_Vertical = _recoil_phase_v[_current_phase];
                Recoil_Horizontal = _recoil_phase_h[_current_phase];
                if (Recoil_Vertical == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_v[_ar_i] != 0) { Recoil_Vertical = _recoil_phase_v[_ar_i]; _ar_i = 0; } } }
                if (Recoil_Horizontal == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_h[_ar_i] != 0) { Recoil_Horizontal = _recoil_phase_h[_ar_i]; _ar_i = 0; } } }
                Recoil_Vertical = Recoil_Vertical + Weapons_RecoilValues[active_weapon * 2];
                Recoil_Horizontal = Recoil_Horizontal + Weapons_RecoilValues[active_weapon * 2 + 1];
                set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical, -100, 100));
                set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal, -100, 100));
            }
        } else {
            AntiRecoil_Timer = 0;
        }
    }
}