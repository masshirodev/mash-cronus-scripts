        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== STATE: States =====
function FlowState_States() {

    // Check if conditional variables changed
    if(AlwaysRunStatus != _prev_AlwaysRunStatus) { _prev_AlwaysRunStatus = AlwaysRunStatus; FlowRedraw = TRUE; }
    if(AutoRunStatus != _prev_AutoRunStatus) { _prev_AutoRunStatus = AutoRunStatus; FlowRedraw = TRUE; }
    if(IsFishing != _prev_IsFishing) { _prev_IsFishing = IsFishing; FlowRedraw = TRUE; }
    if(MashStatus != _prev_MashStatus) { _prev_MashStatus = MashStatus; FlowRedraw = TRUE; }
    if(HorseStatus != _prev_HorseStatus) { _prev_HorseStatus = HorseStatus; FlowRedraw = TRUE; }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_States_img0[0]);
        // Pixel Art: Always Run Status (conditional)
        if(AlwaysRunStatus == 1) { image_oled(48, 18, TRUE, TRUE, Flow_States_img1[0]); }
        // Pixel Art: Auto Run Status (conditional)
        if(AutoRunStatus == 1) { image_oled(48, 25, TRUE, TRUE, Flow_States_img2[0]); }
        // Pixel Art: Fishing Status (conditional)
        if(IsFishing == 1) { image_oled(48, 32, TRUE, TRUE, Flow_States_img3[0]); }
        // Pixel Art: Mash Status (conditional)
        if(MashStatus == 1) { image_oled(48, 39, TRUE, TRUE, Flow_States_img4[0]); }
        // Pixel Art: Horse Status (conditional)
        if(HorseStatus == 1) { image_oled(48, 46, TRUE, TRUE, Flow_States_img5[0]); }
    }

    // Custom code
    // Main render/logic — runs each cycle while in this state

    // Transitions
    if(((get_val(PS5_L2) && event_press(PS5_OPTIONS)) || (GetKeyboardKey(KEY_BACKSPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
}

// ===== STATE: Horse =====
function FlowState_Horse() {
    block_all_inputs();

    // Cursor navigation
    if(((event_press(PS5_UP)) || (GetKeyboardKey(KEY_W) && _kb_nav_delay <= 0)) && Flow_Horse_cursor > 0) { Flow_Horse_cursor = Flow_Horse_cursor - 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
    if(((event_press(PS5_DOWN)) || (GetKeyboardKey(KEY_S) && _kb_nav_delay <= 0)) && Flow_Horse_cursor < 1) { Flow_Horse_cursor = Flow_Horse_cursor + 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Horse_cursor < Flow_Horse_scroll) Flow_Horse_scroll = Flow_Horse_cursor;
    if(Flow_Horse_cursor >= Flow_Horse_scroll + 5) Flow_Horse_scroll = Flow_Horse_cursor - 5 + 1;

    // Toggle: Status
    if(Flow_Horse_cursor == 0 && (event_press(PS5_CROSS) || (GetKeyboardKey(KEY_SPACE) && _kb_nav_delay <= 0))) {
        HorseStatus = !HorseStatus; _kb_nav_delay = 200; FlowRedraw = TRUE;
    }
    // Value adjust: Interval
    if(Flow_Horse_cursor == 1) {
        if((event_press(PS5_LEFT) || (GetKeyboardKey(KEY_A) && _kb_nav_delay <= 0)) && HorseInterval > 0) { HorseInterval = HorseInterval - 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
        if((event_press(PS5_RIGHT) || (GetKeyboardKey(KEY_D) && _kb_nav_delay <= 0)) && HorseInterval < 100) { HorseInterval = HorseInterval + 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
        if(event_press(PS5_L1) && HorseInterval > 0) { HorseInterval = HorseInterval - 10; if(HorseInterval < 0) HorseInterval = 0; FlowRedraw = TRUE; }
        if(event_press(PS5_R1) && HorseInterval < 100) { HorseInterval = HorseInterval + 10; if(HorseInterval > 100) HorseInterval = 100; FlowRedraw = TRUE; }
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Horse_scroll * 9;
        // Pixel Art (merged)
        image_oled(14, 41, TRUE, TRUE, Flow_Horse_img0[0]);
        if(0 >= Flow_Horse_scroll && 0 < Flow_Horse_scroll + 5) {
            // Toggle: Status (index 0)
            if(Flow_Horse_cursor == 0) print(8, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[3]);
            print(20, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[2]);
            if(HorseStatus) print(110, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[0]);
            else print(110, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[1]);
        }
        if(1 >= Flow_Horse_scroll && 1 < Flow_Horse_scroll + 5) {
            // Value: Interval (index 1)
            if(Flow_Horse_cursor == 1) print(8, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[3]);
            print(20, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Horse[4]);
            PrintNumber(HorseInterval, find_digits(HorseInterval), 98, (18 - _oled_y_off), OLED_FONT_SMALL);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }
}

// ===== INIT =====
// ===== GAMEPLAY COMBOS =====
// Combo: Always Run
combo AlwaysRun {
    set_val(PS5_CROSS, 100)
    wait(50)
    set_val(PS5_CROSS, 0)
    wait(50)
}

// Combo: Auto Run
// Auto Run uses direct set_val, no combo needed

// Combo: Custom
combo MashCombo {
    set_val(ButtonToMash, 100);
    wait(50);
    set_val(ButtonToMash, 0);
    wait(50);
}

// Combo: Custom
combo RightStickCircleReeling {
    // 0° - Right
    set_val(PS5_RX, 100);
    set_val(PS5_RY, 0);
    wait(5);
    // 22.5°
    set_val(PS5_RX, 92);
    set_val(PS5_RY, 38);
    wait(5);
    // 45°
    set_val(PS5_RX, 71);
    set_val(PS5_RY, 71);
    wait(5);
    // 67.5°
    set_val(PS5_RX, 38);
    set_val(PS5_RY, 92);
    wait(5);
    // 90° - Down
    set_val(PS5_RX, 0);
    set_val(PS5_RY, 100);
    wait(5);
    // 112.5°
    set_val(PS5_RX, -38);
    set_val(PS5_RY, 92);
    wait(5);
    // 135°
    set_val(PS5_RX, -71);
    set_val(PS5_RY, 71);
    wait(5);
    // 157.5°
    set_val(PS5_RX, -92);
    set_val(PS5_RY, 38);
    wait(5);
    // 180° - Left
    set_val(PS5_RX, -100);
    set_val(PS5_RY, 0);
    wait(5);
    // 202.5°
    set_val(PS5_RX, -92);
    set_val(PS5_RY, -38);
    wait(5);
    // 225°
    set_val(PS5_RX, -71);
    set_val(PS5_RY, -71);
    wait(5);
    // 247.5°
    set_val(PS5_RX, -38);
    set_val(PS5_RY, -92);
    wait(5);
    // 270° - Up
    set_val(PS5_RX, 0);
    set_val(PS5_RY, -100);
    wait(5);
    // 292.5°
    set_val(PS5_RX, 38);
    set_val(PS5_RY, -92);
    wait(5);
    // 315°
    set_val(PS5_RX, 71);
    set_val(PS5_RY, -71);
    wait(5);
    // 337.5°
    set_val(PS5_RX, 92);
    set_val(PS5_RY, -38);
    wait(5);
}

// Combo: Custom
combo HorseStartup {
    set_val(PS5_CROSS, 100);
    wait(50);
    set_val(PS5_CROSS, 0);
    wait(50);
}

combo KeepHorseMomentum {
    set_val(PS5_CROSS, 100);
    wait(50);
    set_val(PS5_CROSS, 0);
    wait(HorseInterval * 10);
}

// ===== PERSISTENCE =====
define SPVAR_BITPACK_START = SPVAR_6;

function Flow_Save() {
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    save_spvar(AlwaysRunStatus, -32768, 32767);
    save_spvar(AlwaysRunThreshold, 50, 100);
    save_spvar(AutoRunStatus, -32768, 32767);
    save_spvar(AutoRunThreshold, 50, 100);
    save_spvar(HorseStatus, 0, 1);
    save_spvar(HorseInterval, 0, 100);
    flush_spvar();
    set_pvar(SPVAR_1, 1);
}

function Flow_Load() {
    if(get_pvar(SPVAR_1, 0x80000000, 0x7FFFFFFF, 0) != 1) return;
    spvar_current_slot = SPVAR_BITPACK_START;
    spvar_current_bit = 0;
    spvar_current_value = 0;
    spvar_total_bits = 0;
    AlwaysRunStatus = read_spvar(-32768, 32767, 0);
    AlwaysRunThreshold = read_spvar(50, 100, 95);
    AutoRunStatus = read_spvar(-32768, 32767, 0);
    AutoRunThreshold = read_spvar(50, 100, 80);
    HorseStatus = read_spvar(0, 1, 0);
    HorseInterval = read_spvar(0, 100, 40);
}

// ===== INIT =====
init {
    FlowCurrentState = FLOW_STATE_Home;
    Flow_Load();
}

// ===== MAIN LOOP =====
main {
    // --- Menu Flow ---
    // State dispatch
    if(FlowCurrentState == FLOW_STATE_Home) { FlowState_Home(); }
    else if(FlowCurrentState == FLOW_STATE_Module_Settings) { FlowState_Module_Settings(); }
    else if(FlowCurrentState == FLOW_STATE_Fishing) { FlowState_Fishing(); }
    else if(FlowCurrentState == FLOW_STATE_Mash) { FlowState_Mash(); }
    else if(FlowCurrentState == FLOW_STATE_States) { FlowState_States(); }
    else if(FlowCurrentState == FLOW_STATE_Horse) { FlowState_Horse(); }

    // State change detection
    if(FlowCurrentState != FlowPrevState) {
        FlowStateTimer = 0;
        FlowPrevState = FlowCurrentState;
        FlowRedraw = TRUE;
        FlowEntered = TRUE;
    }
    FlowStateTimer = FlowStateTimer + get_rtime();
    if(_kb_nav_delay > 0) _kb_nav_delay = _kb_nav_delay - get_rtime();

    // --- Gameplay Flow ---
    // Quick Toggle: Always Run
    if(get_val(PS5_L1) && event_press(PS5_DOWN)) { AlwaysRunStatus = !AlwaysRunStatus; FlowRedraw = TRUE; }
    // Always Run
    if(AlwaysRunStatus) {
        if (get_val(PS5_LY) < -AlwaysRunThreshold) {
            combo_run(AlwaysRun)
        }
    }
    // Quick Toggle: Auto Run
    if(get_val(PS5_L1) && event_press(PS5_UP)) { AutoRunStatus = !AutoRunStatus; FlowRedraw = TRUE; }
    // Auto Run
    if(AutoRunStatus) {
        if (isqrt((get_val(PS5_LX) * get_val(PS5_LX)) + (get_val(PS5_LY) * get_val(PS5_LY))) > AutoRunThreshold) {
            AutoRunStatus = 0;
            FlowRedraw = TRUE;
        }
        set_val(PS5_LY, -100);
        set_val(PS5_CROSS, 100);
    }
    // Quick Toggle: Custom
    if(get_val(PS5_L1) && event_press(PS5_RIGHT)) { MashStatus = !MashStatus; FlowRedraw = TRUE; }
    // Custom
    if(MashStatus) {
        if (get_val(PS5_CROSS)) { ButtonToMash = PS5_CROSS; combo_run(MashCombo); }
        else if (get_val(PS5_TRIANGLE)) { ButtonToMash = PS5_TRIANGLE; combo_run(MashCombo); }
        else if (get_val(PS5_CIRCLE)) { ButtonToMash = PS5_CIRCLE; combo_run(MashCombo); }
        else if (get_val(PS5_SQUARE)) { ButtonToMash = PS5_SQUARE; combo_run(MashCombo); }
        else combo_stop(MashCombo);
    }
    // Quick Toggle: Custom
    if(get_val(PS5_L1) && event_press(PS5_LEFT)) { IsFishing = !IsFishing; FlowRedraw = TRUE; }
    // Custom
    if(IsFishing) {
        if (get_val(PS5_R2) && get_val(PS5_L2))
            combo_run(RightStickCircleReeling);
        else
            combo_stop(RightStickCircleReeling);
    }
    // Quick Toggle: Custom
    if(get_val(PS5_L1) && event_press(PS5_CIRCLE)) { HorseStatus = !HorseStatus; FlowRedraw = TRUE; }
    // Custom
    if(HorseStatus) {
        if (get_val(PS5_CROSS)) combo_run(HorseStartup)
        else combo_stop(HorseStartup); combo_run(KeepHorseMomentum);
    }
}