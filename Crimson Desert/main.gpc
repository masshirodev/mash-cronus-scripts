// ===== MENU FLOW =====
// ====================================================
// Flow: Menu Flow
// Generated by ZenForge Flow Editor
// States: 6 | Transitions: 6
// ====================================================

// ===== STATE DEFINITIONS =====
define FLOW_STATE_Home = 0;
define FLOW_STATE_Module_Settings = 1;
define FLOW_STATE_Fishing = 2;
define FLOW_STATE_Mash = 3;
define FLOW_STATE_States = 4;
define FLOW_STATE_Horse = 5;

define Flow_Module_Settings_total_items = 5;
define Flow_Module_Settings_visible = 4;
define Flow_Horse_total_items = 2;
define Flow_Horse_visible = 5;

// ===== VARIABLES =====
int FlowCurrentState;
int FlowPrevState = -1;
int FlowStateTimer;
int FlowRedraw = TRUE;
int FlowEntered;
int FlowStateStack[8];
int FlowStackTop = 0;
int _kb_nav_delay;
int _oled_y_off;

// Variables for Module Settings
int Flow_Module_Settings_cursor;
int Flow_Module_Settings_scroll;

// Variables for Horse
int Flow_Horse_cursor;
int Flow_Horse_scroll;

// Conditional sub-node tracking
int _prev_AlwaysRunStatus;
int _prev_AutoRunStatus;
int _prev_IsFishing;
int _prev_MashStatus;
int _prev_HorseStatus;




// ===== STATE: Home =====
function FlowState_Home() {

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        // Pixel Art (merged)
        image_oled(0, 0, TRUE, TRUE, Flow_Home_img0[0]);
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(((get_val(PS5_L2) && event_press(PS5_OPTIONS)) || (GetKeyboardKey(KEY_BACKSPACE) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Module_Settings;
    }
    if(FlowStateTimer > 3000) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_States;
    }
}

// ===== STATE: Module Settings =====
function FlowState_Module_Settings() {
    block_all_inputs();

    // Cursor navigation
    if(((event_press(PS5_UP)) || (GetKeyboardKey(KEY_W) && _kb_nav_delay <= 0)) && Flow_Module_Settings_cursor > 0) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor - 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
    if(((event_press(PS5_DOWN)) || (GetKeyboardKey(KEY_S) && _kb_nav_delay <= 0)) && Flow_Module_Settings_cursor < 4) { Flow_Module_Settings_cursor = Flow_Module_Settings_cursor + 1; _kb_nav_delay = 200; FlowRedraw = TRUE; }
    // Window scrolling
    if(Flow_Module_Settings_cursor < Flow_Module_Settings_scroll) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor;
    if(Flow_Module_Settings_cursor >= Flow_Module_Settings_scroll + 4) Flow_Module_Settings_scroll = Flow_Module_Settings_cursor - 4 + 1;

    // Toggle: Always Run
    if(Flow_Module_Settings_cursor == 0 && (event_press(PS5_CROSS) || (GetKeyboardKey(KEY_SPACE) && _kb_nav_delay <= 0))) {
        AlwaysRunStatus = !AlwaysRunStatus; _kb_nav_delay = 200; FlowRedraw = TRUE;
    }
    // Toggle: Auto Run
    if(Flow_Module_Settings_cursor == 1 && (event_press(PS5_CROSS) || (GetKeyboardKey(KEY_SPACE) && _kb_nav_delay <= 0))) {
        AutoRunStatus = !AutoRunStatus; _kb_nav_delay = 200; FlowRedraw = TRUE;
    }
    // Toggle: Fishing (?)
    if(Flow_Module_Settings_cursor == 2 && (event_press(PS5_CROSS) || (GetKeyboardKey(KEY_SPACE) && _kb_nav_delay <= 0))) {
        IsFishing = !IsFishing; _kb_nav_delay = 200; FlowRedraw = TRUE;
    }
    // Toggle: Mash (?)
    if(Flow_Module_Settings_cursor == 3 && (event_press(PS5_CROSS) || (GetKeyboardKey(KEY_SPACE) && _kb_nav_delay <= 0))) {
        MashStatus = !MashStatus; _kb_nav_delay = 200; FlowRedraw = TRUE;
    }

    // Render
    if(FlowRedraw) {
        FlowRedraw = FALSE;
        cls_oled(OLED_BLACK);
        _oled_y_off = Flow_Module_Settings_scroll * 9;
        // Pixel Art (merged)
        image_oled(2, 51, TRUE, TRUE, Flow_Module_Settings_img0[0]);
        if(0 >= Flow_Module_Settings_scroll && 0 < Flow_Module_Settings_scroll + 4) {
            // Toggle: Always Run (index 0)
            if(Flow_Module_Settings_cursor == 0) print(8, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            print(20, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[2]);
            if(AlwaysRunStatus) print(110, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
            else print(110, (9 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        if(1 >= Flow_Module_Settings_scroll && 1 < Flow_Module_Settings_scroll + 4) {
            // Toggle: Auto Run (index 1)
            if(Flow_Module_Settings_cursor == 1) print(8, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            print(20, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[4]);
            if(AutoRunStatus) print(110, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
            else print(110, (18 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        if(2 >= Flow_Module_Settings_scroll && 2 < Flow_Module_Settings_scroll + 4) {
            // Toggle: Fishing (?) (index 2)
            if(Flow_Module_Settings_cursor == 2) print(8, (27 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            print(20, (27 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[5]);
            if(IsFishing) print(110, (27 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
            else print(110, (27 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        if(3 >= Flow_Module_Settings_scroll && 3 < Flow_Module_Settings_scroll + 4) {
            // Toggle: Mash (?) (index 3)
            if(Flow_Module_Settings_cursor == 3) print(8, (36 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            print(20, (36 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[6]);
            if(MashStatus) print(110, (36 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[0]);
            else print(110, (36 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[1]);
        }
        if(4 >= Flow_Module_Settings_scroll && 4 < Flow_Module_Settings_scroll + 4) {
            // Menu Item: Horse (index 4)
            if(Flow_Module_Settings_cursor == 4) {
                print(8, (45 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[3]);
            }
            print(20, (45 - _oled_y_off), OLED_FONT_SMALL, OLED_WHITE, FlowText_Module_Settings[7]);
        }
    }

    // Back button
    if(((event_press(PS5_CIRCLE)) || (GetKeyboardKey(KEY_ESC) && FlowStateTimer > 150)) && FlowStackTop > 0) {
        FlowStackTop = FlowStackTop - 1;
        FlowCurrentState = FlowStateStack[FlowStackTop];
    }

    // Transitions
    if(Flow_Module_Settings_cursor == 3 && ((event_press(PS5_SQUARE)) || (GetKeyboardKey(KEY_E) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Mash;
    }
    if(Flow_Module_Settings_cursor == 2 && ((event_press(PS5_SQUARE)) || (GetKeyboardKey(KEY_E) && FlowStateTimer > 150))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Fishing;
    }
    if(Flow_Module_Settings_cursor == 4 && (event_press(PS5_CROSS))) {
        if(FlowStackTop < 8) { FlowStateStack[FlowStackTop] = FlowCurrentState; FlowStackTop = FlowStackTop + 1; }
        FlowCurrentState = FLOW_STATE_Horse;
    }
}

