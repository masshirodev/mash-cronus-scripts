          "stackOffsetX": 0.0,
          "stackOffsetY": 0.0,
          "visibleCount": null,
          "scrollMode": null,
          "backButton": null,
          "blockInputs": null,
          "moduleData": {
            "moduleId": "antirecoil_timeline",
            "moduleName": "Anti Recoil (Timeline)",
            "triggerCondition": "",
            "enableVariable": "AntiRecoilStatus",
            "initCode": "",
            "mainCode": "// Anti-recoil (phase-based) with per-weapon recoil curves\nif (AntiRecoilStatus && get_val(PS5_L2) && get_val(PS5_R2)) {\n    AntiRecoil_Timer++;\n    if (AntiRecoil_Timer == 1) {\n        active_weapon = GetActiveWeapon();\n        if (active_weapon != _last_recoil_weapon) {\n            LoadRecoilPhases(active_weapon);\n        }\n    }\n    if (AntiRecoil_Timer >= ANTIRECOIL_INIT_DELAY) {\n        _current_phase = AntiRecoil_Timer / RECOIL_PHASE_STEP;\n        if (_current_phase >= RECOIL_PHASES) _current_phase = RECOIL_PHASES - 1;\n        Recoil_Vertical = _recoil_phase_v[_current_phase];\n        Recoil_Horizontal = _recoil_phase_h[_current_phase];\n        if (Recoil_Vertical == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_v[_ar_i] != 0) { Recoil_Vertical = _recoil_phase_v[_ar_i]; _ar_i = 0; } } }\n        if (Recoil_Horizontal == 0 && _current_phase > 0) { _ar_i = _current_phase; while (_ar_i > 0) { _ar_i--; if (_recoil_phase_h[_ar_i] != 0) { Recoil_Horizontal = _recoil_phase_h[_ar_i]; _ar_i = 0; } } }\n        Recoil_Vertical = Recoil_Vertical + Weapons_RecoilValues[active_weapon * 2];\n        Recoil_Horizontal = Recoil_Horizontal + Weapons_RecoilValues[active_weapon * 2 + 1];\n        set_val(PS5_RY, clamp(get_val(PS5_RY) + Recoil_Vertical, -100, 100));\n        set_val(PS5_RX, clamp(get_val(PS5_RX) + Recoil_Horizontal, -100, 100));\n    }\n} else {\n    AntiRecoil_Timer = 0;\n}",
            "functionsCode": "define RECOIL_PHASES = 10;\ndefine RECOIL_PHASE_STEP = 18;\ndefine ANTIRECOIL_INIT_DELAY = 15;\nfunction LoadRecoilPhases(weapon_id) {\n    for (_current_phase = 0; _current_phase < RECOIL_PHASES; _current_phase++) {\n        _recoil_phase_v[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2];\n        _recoil_phase_h[_current_phase] = WeaponRecoilTable[weapon_id][_current_phase * 2 + 1];\n    }\n    for (_current_phase = 1; _current_phase < RECOIL_PHASES; _current_phase++) {\n        if (_recoil_phase_v[_current_phase] == 0 && _recoil_phase_v[_current_phase - 1] != 0) {\n            _recoil_phase_v[_current_phase] = _recoil_phase_v[_current_phase - 1];\n        }\n        if (_recoil_phase_h[_current_phase] == 0 && _recoil_phase_h[_current_phase - 1] != 0) {\n            _recoil_phase_h[_current_phase] = _recoil_phase_h[_current_phase - 1];\n        }\n    }\n    _last_recoil_weapon = weapon_id;\n}",
            "comboCode": "",
            "triggerCode": null,
            "options": [
              {
                "name": "Status",
                "variable": "AntiRecoilStatus",
                "type": "toggle",
                "defaultValue": 0,
                "min": null,
                "max": null,
                "arrayName": null,
                "arraySize": null
              }
            ],
            "extraVars": {
              "_last_recoil_weapon": "int = -1",
              "_recoil_phase_h": "int [10]",
              "_ar_i": "int",
              "_current_phase": "int",
              "active_weapon": "int",
              "AntiRecoil_Timer": "int",
              "Recoil_Vertical": "int",
              "_recoil_phase_v": "int [10]",
