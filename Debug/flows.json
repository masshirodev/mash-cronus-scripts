          "gpcCode": "// Clear all phases\nif(TLDebug_Clear) {\n    for(_tld_i = 0; _tld_i < 10; _tld_i++) { _recoil_phase_v[_tld_i] = 0; _recoil_phase_h[_tld_i] = 0; }\n    TLDebug_V = 0; TLDebug_H = 0; TLDebug_Clear = FALSE; FlowRedraw = TRUE;\n}\n\n// Two-way sync: array <-> shadow vars\nif(_recoil_phase_v[TLDebug_Phase] != TLDebug_V) { TLDebug_V = _recoil_phase_v[TLDebug_Phase]; FlowRedraw = TRUE; }\nif(_recoil_phase_h[TLDebug_Phase] != TLDebug_H) { TLDebug_H = _recoil_phase_h[TLDebug_Phase]; FlowRedraw = TRUE; }\n\n// Weapon name\nprint(2, 35, OLED_FONT_SMALL, OLED_WHITE, Weapons[active_weapon]);\n\n// Timeline bar chart (V values by phase)\nline_oled(0, 43, 127, 43, 1, OLED_WHITE);\nfor(_tld_i = 0; _tld_i < 10; _tld_i++) {\n    _tld_bh = abs(_recoil_phase_v[_tld_i]) * 18 / 100;\n    if(_tld_bh > 0) {\n        rect_oled(_tld_i * 12 + 4, 63 - _tld_bh, 10, _tld_bh, 1, OLED_WHITE);\n    }\n    // Mark current phase\n    if(_tld_i == TLDebug_Phase) {\n        rect_oled(_tld_i * 12 + 4, 44, 10, 1, 1, OLED_WHITE);\n    }\n}",
