          "moduleData": {
            "moduleId": "weapondata",
            "moduleName": "Weapon Data",
            "triggerCondition": "",
            "enableVariable": "Weapondata_Enabled",
            "initCode": "",
            "mainCode": "// Weapon data initialization\nif (!WeaponData_Initialized) {\n    InitializeWeaponData();\n    WeaponData_Initialized = TRUE;\n}",
            "functionsCode": "function GetActiveWeapon() {\n    return CurrentWeapon;\n}\n\nfunction InitializeWeaponData() {\n    for (weapon_init_idx = 0; weapon_init_idx < WEAPON_COUNT; weapon_init_idx++) {\n        Weapons_RecoilValues[weapon_init_idx * 2] = 0;\n        Weapons_RecoilValues[weapon_init_idx * 2 + 1] = 0;\n    }\n}",
            "comboCode": "",
            "triggerCode": null,
            "options": [],
            "extraVars": {
              "Weapons_RecoilValues": "int [216]",
              "WeaponData_Initialized": "int",
              "CurrentWeapon": "int [profile]",
              "weapon_init_idx": "int"
            },
            "params": null,
